// One row per attendance photo submitted by an incharge on an employee's
// behalf (see AttendanceController.submitPunch) — kept as a permanent,
// append-only log distinct from HrAttendance's one-row-per-day summary so
// an 'in' punch's photo/location is never overwritten by a later 'out'.
model HrAttendancePunch {
  id           String   @id @default(cuid())
  employee_id  String   @db.Text
  date         String   @db.Text // YYYY-MM-DD
  punch_type   String   @db.Text // in | out | half_day | full_day
  punch_time   String   @db.Text // HH:MM
  photo_url    String   @db.Text
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  submitted_by String?  @db.Text // name/id of the incharge who submitted this
  notes        String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamptz()

  employee Employee? @relation(fields: [employee_id], references: [employee_id])

  @@index([employee_id])
  @@index([date])
  @@map("hr_attendance_punch")
}

