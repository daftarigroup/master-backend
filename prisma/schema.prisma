  offered_ctc      String?  @db.Text
  monthly_salary   Decimal? @db.Decimal(12, 2)
  bank_account     String?  @db.Text
  ifsc_code        String?  @db.Text
  bank_branch_name String?  @db.Text
  payment_mode     String?  @db.Text
  pf_eligible      Boolean? @default(false)
  esic_eligible    Boolean? @default(false)
  past_pf_no       String?  @db.Text
  esic_no          String?  @db.Text

  // Personal Details & Identification
  blood_group           String? @db.Text
  father_name           String? @db.Text
  highest_qualification String? @db.Text
  current_address       String? @db.Text
  aadhar_address        String? @db.Text
  aadhar_no             String? @db.Text

  // Emergency Contact
  emergency_contact_name     String? @db.Text
  emergency_contact_phone    String? @db.Text
  emergency_contact_relation String? @db.Text

  // Asset Issuance Flags
  email_to_be_issued  Boolean? @default(false)
  mobile_to_be_issued Boolean? @default(false)
  laptop_to_be_issued Boolean? @default(false)

  // Candidate link & Onboarding / Separation Flags
  candidate_id           BigInt?  @unique
  salary_on_hold         Boolean? @default(false)
  salary_hold_reason     String?  @db.Text
  offer_letter_issued    Boolean? @default(false)
  id_card_issued         Boolean? @default(false)
  induction_done         Boolean? @default(false)
  onboarding_checklist   Json?
  exit_checklist         Json?
  custom_checklist_items Json?

  // Timestamps
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()

  // Relations
  user                User?               @relation(fields: [user_id], references: [id])
  department          Department?         @relation(fields: [department_id], references: [id])
  home_firm           Firm?               @relation("EmployeeHomeFirm", fields: [home_firm_id], references: [id])
  project_assignments ProjectAssignment[]
  candidate           HrCandidate?        @relation(fields: [candidate_id], references: [id])
  joining             HrJoining?
  attendances         HrAttendance[]
  attendance_claims   HrAttendanceClaim[]
  attendance_punches  HrAttendancePunch[]
  leaves              HrLeave[]
  gate_passes         HrGatePass[]
  advance_requests    HrAdvanceRequest[]
  loans               HrEmployeeLoan[]
  salary_structure    HrSalaryStructure?
  payslips            HrPayslip[]

  @@index([status])
  @@index([home_firm_id])
  @@index([department_id])
  @@index([phone])
  @@map("employee")
}

