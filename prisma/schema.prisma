  @@map("received")
}

model SiteEngineerDetails {
  id        Int     @id @default(autoincrement())
  name      String  @db.Text
  number    String  @db.Text
  email     String? @db.Text
  firm_id   BigInt?
  firm_name String? @db.Text
  firm      Firm?   @relation(fields: [firm_id], references: [id])

  @@map("site_engineer_details")
}

model SiteLocationDetails {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamptz()
  location   String    @db.Text
  firm_id    BigInt?
  firm_name  String?   @db.Text
  firm       Firm?     @relation(fields: [firm_id], references: [id])

  @@map("site_location_details")
}

model Stock {
  id            BigInt   @id @default(autoincrement())
