model HrPayslip {
  id                  BigInt    @id @default(autoincrement())
  employee_id         String    @db.Text
  month               Int
  year                Int
  total_working_days  Decimal   @default(30) @db.Decimal(5, 2)
  present_days        Decimal   @default(0) @db.Decimal(5, 2)
  leave_days          Decimal   @default(0) @db.Decimal(5, 2)
  overtime_hours      Decimal   @default(0) @db.Decimal(5, 2)
  overtime_pay        Decimal   @default(0) @db.Decimal(12, 2)
  gross_salary        Decimal   @default(0) @db.Decimal(12, 2)
  total_deductions    Decimal   @default(0) @db.Decimal(12, 2)
  loan_deduction      Decimal   @default(0) @db.Decimal(12, 2)
  net_salary          Decimal   @default(0) @db.Decimal(12, 2)
  status              String    @default("pending") // pending, paid
  paid_date           DateTime? @db.Timestamptz()

  // Salary structure breakdown (earned amounts, prorated by attendance)
  structure_id        BigInt?
  monthly_ctc         Decimal   @default(0) @db.Decimal(12, 2)
  calculation_days    Decimal   @default(0) @db.Decimal(5, 2)
  basic               Decimal   @default(0) @db.Decimal(12, 2)
  hra                 Decimal   @default(0) @db.Decimal(12, 2)
  conveyance          Decimal   @default(0) @db.Decimal(12, 2)
  medical_allowance   Decimal   @default(0) @db.Decimal(12, 2)
  special_allowance   Decimal   @default(0) @db.Decimal(12, 2)
  other_allowances    Decimal   @default(0) @db.Decimal(12, 2)
  additional_salary   Decimal   @default(0) @db.Decimal(12, 2)
  employer_pf         Decimal   @default(0) @db.Decimal(12, 2)
  employer_esic       Decimal   @default(0) @db.Decimal(12, 2)
  deduction_breakdown Json?     @default("[]")

  created_at          DateTime  @default(now()) @db.Timestamptz()
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz()

  employee            Employee? @relation(fields: [employee_id], references: [employee_id])

  @@unique([employee_id, month, year])
  @@index([employee_id])
  @@index([month, year])
  @@map("hr_payslip")
}

