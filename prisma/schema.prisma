// ----- Repair -----

// Deliberately separate from Store's `Vendors` model — repair/AMC vendors (outhouse
// repair shops, spares suppliers, authorized OEMs) are a different pool with
// different fields than procurement/raw-material vendors; see decision #2 in the
// architecture doc.
model RepairVendor {
  id           String   @id @default(cuid())
  firmId       BigInt?
  name         String
  type         String? // e.g. "Outhouse Repair" | "Spares Supplier" | "Authorized OEM" — free text, not enforced as an enum since new vendor types are common
  gstNumber    String?
  email        String?
  address      String?
  mobileNumber String?
  contactName  String?
  createdAt    DateTime @default(now())

  firm          Firm?               @relation(fields: [firmId], references: [id])
  spareParts    SparePart[]
  repairIndents RepairIndent[]
  offers        RepairVendorOffer[]
  amcContracts  AMCContract[]

  rentedMachines       Machine[]              @relation("MachineRentalVendor")
  outsourcedWorkOrders MaintenanceWorkOrder[] @relation("WorkOrderVendor")

  @@index([firmId])
  @@map("repair_vendors")
}

model SparePart {
  id          String   @id @default(cuid())
  firmId      BigInt?
  partName    String
  partCode    String?  @unique
  machineType String?
  vendorId    String?
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  stockQty    Int      @default(0)
  minStockQty Int      @default(0)
  unit        String?
  description String?
  createdAt   DateTime @default(now())

  firm         Firm?              @relation(fields: [firmId], references: [id])
  vendor       RepairVendor?      @relation(fields: [vendorId], references: [id])
  indentUsages RepairIndentPart[]

  @@index([firmId])
  @@map("spare_parts")
}

model RepairIndent {
  id                   String                 @id @default(cuid())
  firmId               BigInt?
  indentNumber         String?                @unique
  machineId            String?
  assetId              String?
  machinePartId        String? // which part of the machine is broken — real picker (MachinePart), selected at indent creation
  doerUserId           BigInt? // logged-by user — real `/user/list` picker, same convention as Maintenance's assignee fields
  departmentId         BigInt? // usually auto-filled from machine.departmentId server-side; no department picker in this form
  problem              String
  priority             Priority               @default(MEDIUM)
  status               RepairIndentStatus     @default(PENDING)
  approvalStatus       ApprovalDecisionStatus @default(PENDING)
  routingType          RepairRoutingType?
  expectedDeliveryDays Int?
  location             String?
  image                String?
  remarks              String?
  soundOfMachine       String?
  temperature          String?
  maintenanceCost      Decimal?               @db.Decimal(12, 2)
  approvedAt           DateTime?
  vendorId             String?
  technicianId         String?
  technicianAssignedAt DateTime?
  technicianWorkNotes  String?
  workOrderId          String?                @map("work_order_id")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  firm           Firm?              @relation(fields: [firmId], references: [id])
  machine        Machine?           @relation(fields: [machineId], references: [id])
  asset          Asset?             @relation(fields: [assetId], references: [id])
  machinePart    MachinePart?       @relation(fields: [machinePartId], references: [id])
  department     Department?        @relation(fields: [departmentId], references: [id])
  doer           User?              @relation("IndentDoer", fields: [doerUserId], references: [id])
  vendor         RepairVendor?      @relation(fields: [vendorId], references: [id])
  technician     Technician?        @relation(fields: [technicianId], references: [id])
  parts          RepairIndentPart[]
  outhouseRepair OuthouseRepair?
  workOrder      MaintenanceWorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([machineId])
  @@index([workOrderId])
  @@index([assetId])
  @@index([firmId])
  @@index([status])
  @@map("repair_indents")
}

// Parts-used line items — fills the gap where the frontend only had a single
// `machinePartName` string per indent plus an aggregated `Asset.partNames[]` array.
model RepairIndentPart {
  id       String   @id @default(cuid())
  indentId String
  partId   String?
  partName String
  quantity Int      @default(1)
  cost     Decimal? @db.Decimal(12, 2)

  indent RepairIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  part   SparePart?   @relation(fields: [partId], references: [id])

  @@index([indentId])
  @@map("repair_indent_parts")
}

// 1:1 with RepairIndent when routingType = OUTHOUSE. The frontend flattened dispatch
// -> receiving/inspection -> billing -> payment into one `RBOuthouseRepair` record;
// split here into per-stage child tables (RepairDispatch/RepairReceiving/RepairPayment)
// since each stage is filled in by a different screen at a different point in time.
model OuthouseRepair {
  id               String    @id @default(cuid())
  indentId         String    @unique
  vendorRemarks    String?
  vendorAssignedAt DateTime?
  rateApprovedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  indent    RepairIndent        @relation(fields: [indentId], references: [id], onDelete: Cascade)
  offers    RepairVendorOffer[]
  dispatch  RepairDispatch?
  receiving RepairReceiving?
  payment   RepairPayment?

  @@map("outhouse_repairs")
}

// Competing vendor rate quotes for an outhouse repair — one gets isApproved = true.
model RepairVendorOffer {
  id               String   @id @default(cuid())
  outhouseRepairId String
  vendorId         String
  rate             Decimal  @db.Decimal(12, 2)
  paymentTerm      String?
  isApproved       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  outhouseRepair OuthouseRepair @relation(fields: [outhouseRepairId], references: [id], onDelete: Cascade)
  vendor         RepairVendor   @relation(fields: [vendorId], references: [id])

  @@index([outhouseRepairId])
  @@map("repair_vendor_offers")
}

// Sent-machine stage: machine dispatched to the outhouse vendor.
model RepairDispatch {
  id                    String    @id @default(cuid())
  outhouseRepairId      String    @unique
  transporterName       String?
  vehicleNo             String?
  driverName            String?
  driverContact         String?
  transportationCharges Decimal?  @db.Decimal(12, 2)
  weighmentSlipNo       String?
  transportImage        String?
  sentPaymentType       String?
  sentPaymentAmount     Decimal?  @db.Decimal(12, 2)
  sentAt                DateTime?
  expectedReturnDate    DateTime?

  outhouseRepair OuthouseRepair @relation(fields: [outhouseRepairId], references: [id], onDelete: Cascade)

  @@map("repair_dispatches")
}

// Store-in stage: machine received back, inspected, bill logged.
model RepairReceiving {
  id                    String            @id @default(cuid())
  outhouseRepairId      String            @unique
  inspectedByUserId     BigInt?
  inspectedByName       String?
  inspectionResult      InspectionResult?
  inspectionRemarks     String?
  returnTransporterName String?
  returnTransportAmount Decimal?          @db.Decimal(12, 2)
  billImage             String?
  billNo                String?
  typeOfBill            String?
  totalBillAmount       Decimal?          @db.Decimal(12, 2)
  toBePaidAmount        Decimal?          @db.Decimal(12, 2)
  receivedAt            DateTime?
  status                StoreInStatus     @default(PENDING_VERIFICATION)

  outhouseRepair OuthouseRepair @relation(fields: [outhouseRepairId], references: [id], onDelete: Cascade)
  inspectedBy    User?          @relation("ReceivingInspectedBy", fields: [inspectedByUserId], references: [id])

  @@map("repair_receivings")
}

// Payment stage: final billing/payment reconciliation.
model RepairPayment {
  id                 String              @id @default(cuid())
  outhouseRepairId   String              @unique
  billMatch          Boolean?
  billStatus         String?
  finalPaymentAmount Decimal?            @db.Decimal(12, 2)
  paymentMode        RepairPaymentMode?
  status             RepairPaymentStatus @default(PENDING_APPROVAL)
  paidAt             DateTime?

  outhouseRepair OuthouseRepair @relation(fields: [outhouseRepairId], references: [id], onDelete: Cascade)

  @@map("repair_payments")
}

model Technician {
  id           String   @id @default(cuid())
  firmId       BigInt?
  name         String
  contact      String?
  whatsapp     String?
  departmentId BigInt?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  firm       Firm?          @relation(fields: [firmId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  indents    RepairIndent[]

  @@index([firmId])
  @@map("technicians")
}

model AMCContract {
  id              String    @id @default(cuid())
  firmId          BigInt?
  contractNumber  String?   @unique
  machineId       String?
  assetId         String?
  vendorId        String?
  startDate       DateTime
  endDate         DateTime
  annualCost      Decimal   @db.Decimal(12, 2)
  visitsPerYear   Int       @default(0)
  completedVisits Int       @default(0)
  status          AMCStatus @default(ACTIVE)
  scope           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  firm    Firm?         @relation(fields: [firmId], references: [id])
  machine Machine?      @relation(fields: [machineId], references: [id])
  asset   Asset?        @relation(fields: [assetId], references: [id])
  vendor  RepairVendor? @relation(fields: [vendorId], references: [id])

  @@index([firmId])
  @@map("amc_contracts")
}

// Atomic counter backing every "{PREFIX}-{YEAR}-{seq}" business code (REP-2026-001,
// WO-2026-001, BD-2026-001, AMC-2026-001, ...). Replaces the frontend mocks'
// collision-prone `array.length + 1` numbering (breaks after any delete) — increment
// lastValue inside a transaction per code generation.
model DocumentSequence {
  id        String  @id @default(cuid())
  // 0 is the "no firm" sentinel (see services/documentSequence.service.ts), so this column is deliberately NOT a
  // foreign key to Firm: no firm has id 0, and a declared FK made every firm-less code (SN, PLN, WO, BD, REP, AMC)
  // fail on any database built from this schema. Existing databases never had the constraint.
  firmId    BigInt?
  prefix    String
  year      Int
  lastValue Int     @default(0)

  @@unique([firmId, prefix, year])
  @@map("document_sequences")
}

// ===================== FLEET: OWNERSHIP, DIESEL LEDGER, USAGE LOGBOOK (fleet_v1) =====================
// Design: md/FLEET_DIESEL_AND_MAINTENANCE_MERGE_PLAN.md. Partial unique indexes and CHECK constraints
// live only in the SQL migration (Prisma cannot express them): one OPENING receipt per firm,
// one OPEN usage entry per machine, litres > 0, stop >= start, usage null <=> stop null.

enum OwnershipType {
  OWNED
  RENTED
}

enum ReadingUnit {
  KM
  HOURS
  NONE
}

enum HireType {
  DRY
  WET
}

enum EquipmentType {
  EXCAVATOR
  BACKHOE_LOADER
  TIPPER
  TRUCK
  TRANSIT_MIXER
  ROLLER
  TRACTOR
  WATER_PUMP
  DG_SET
  CAR
  OTHER
  LOADER
  DOZER
  GRADER
  CRANE
  CONCRETE_PUMP
  BATCHING_PLANT
  COMPRESSOR
  WATER_TANKER
}

enum DieselReceiptKind {
  RECEIPT
  OPENING
  ADJUSTMENT
}

enum DieselReceiptSource {
  MANUAL
  STORE_ISSUE
  STORE_IN
}

enum DieselLogSource {
  MANUAL
  STORE_ISSUE
}

enum OutsourceStatus {
  TO_SEND
  SENT
  RECEIVED
  PAID
}

// Diesel coming INTO a firm's site stock ("QTY RECEIVED", opening balance, corrections).
model DieselReceipt {
  id             String              @id @default(cuid())
  firmId         BigInt
  siteLocationId BigInt?
  kind           DieselReceiptKind   @default(RECEIPT)
  receivedAt     DateTime            @db.Timestamptz(3)
  receiptDate    DateTime            @db.Date // IST calendar day, for grouping
  litres         Decimal             @db.Decimal(10, 2) // > 0, except ADJUSTMENT
  issuerName     String?
  source         DieselReceiptSource @default(MANUAL)
  externalRef    String?             @unique
  supplierName   String?
  reference      String?
  note           String?
  ratePerLitre   Decimal?            @db.Decimal(10, 4) // purchase price; both null = unpriced
  totalAmount    Decimal?            @db.Decimal(14, 2)
  createdById    BigInt
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  voidedAt       DateTime?           @db.Timestamptz(3)
  voidedById     BigInt?
  voidReason     String?

  firm         Firm                 @relation(fields: [firmId], references: [id])
  siteLocation SiteLocationDetails? @relation(fields: [siteLocationId], references: [id])
  createdBy    User                 @relation("DieselReceiptCreatedBy", fields: [createdById], references: [id])
  voidedBy     User?                @relation("DieselReceiptVoidedBy", fields: [voidedById], references: [id])

  @@index([firmId, receiptDate])
  @@map("diesel_receipts")
}

// Diesel issued OUT to a machine, or to a free-text consumer ("other diesel").
model DieselLog {
  id             String          @id @default(cuid())
  firmId         BigInt
  siteLocationId BigInt?
  machineId      String?
  consumerLabel  String?
  usageLogId     String?
  issuedAt       DateTime        @db.Timestamptz(3)
  issueDate      DateTime        @db.Date
  litres         Decimal         @db.Decimal(10, 2)
  source         DieselLogSource @default(MANUAL)
  externalRef    String?         @unique // Store issue id later; idempotency key for recordIssue()
  wbsActivityId  String?
  // valuation stamped when the issue is written; all three null = not priced yet
  ratePerLitre   Decimal?        @db.Decimal(10, 4)
  amount         Decimal?        @db.Decimal(14, 2)
  rateSource     DieselRateSource?
  note           String?
  createdById    BigInt
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  voidedAt       DateTime?       @db.Timestamptz(3)
  voidedById     BigInt?
  voidReason     String?
  // fleet_v6_store_diesel: fed by an approved Store issue (source STORE_ISSUE)
  meterReading   Decimal?        @db.Decimal(14, 2)
  storeIssueId   BigInt?
  flags          String[]        @default([]) // review flags: READING_BELOW_LAST, READING_JUMP (saved, not blocked)

  firm         Firm                 @relation(fields: [firmId], references: [id])
  siteLocation SiteLocationDetails? @relation(fields: [siteLocationId], references: [id])
  storeIssue   Issue?               @relation("StoreIssueDieselLog", fields: [storeIssueId], references: [id], onDelete: SetNull)
  machine      Machine?             @relation(fields: [machineId], references: [id], onDelete: Restrict) // a machine with diesel history cannot be deleted
  usageLog     MachineUsageLog?     @relation(fields: [usageLogId], references: [id])
  wbsActivity  WbsActivity?         @relation(fields: [wbsActivityId], references: [id])
  createdBy    User                 @relation("DieselLogCreatedBy", fields: [createdById], references: [id])
  voidedBy     User?                @relation("DieselLogVoidedBy", fields: [voidedById], references: [id])

  @@index([firmId, issueDate])
  @@index([machineId, issueDate])
  @@map("diesel_logs")
}

// Meter-based usage: start/stop readings per entry. Replaces DailyMachineLog.
model MachineUsageLog {
  id               String    @id @default(cuid())
  firmId           BigInt
  machineId        String
  logDate          DateTime  @db.Date
  startedAt        DateTime  @db.Timestamptz(3)
  stoppedAt        DateTime? @db.Timestamptz(3)
  startReading     Decimal   @db.Decimal(12, 2)
  stopReading      Decimal?  @db.Decimal(12, 2) // null = OPEN entry
  usage            Decimal?  @db.Decimal(12, 2) // written by the service only; null while open
  meterReset       Boolean   @default(false)
  meterResetReason String?
  continuityGap    Decimal?  @db.Decimal(12, 2)
  continuityReason String?
  isFlagged        Boolean   @default(false)
  flagReasons      String[]  @default([])
  operatorId       BigInt?
  remarks          String?
  createdById      BigInt
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  voidedAt         DateTime? @db.Timestamptz(3)
  voidedById       BigInt?
  voidReason       String?
  wbsActivityId    String?
  // fleet_v3_ops: a work log is this row. History is APPROVED; new entries start PENDING.
  logNumber       String?
  shift           WorkShift     @default(DAY)
  workTypeId      String?
  locationText    String?
  outputQty       Decimal?      @db.Decimal(14, 3)
  outputUnit      String?
  trips           Int?
  status          WorkLogStatus @default(PENDING)
  approvedById    BigInt?
  approvedAt      DateTime?     @db.Timestamptz(3)
  rejectReason    String?
  clientRequestId String?

  workType   WorkType?   @relation(fields: [workTypeId], references: [id])
  approvedBy User?       @relation("UsageLogApprovedBy", fields: [approvedById], references: [id])
  statusLogs WorkLogStatusLog[]

  firm       Firm        @relation(fields: [firmId], references: [id])
  machine    Machine     @relation(fields: [machineId], references: [id])
  wbsActivity WbsActivity? @relation(fields: [wbsActivityId], references: [id])
  operator   User?       @relation("UsageLogOperator", fields: [operatorId], references: [id])
  createdBy  User        @relation("UsageLogCreatedBy", fields: [createdById], references: [id])
  voidedBy   User?       @relation("UsageLogVoidedBy", fields: [voidedById], references: [id])
  dieselLogs DieselLog[]

  @@index([machineId, startedAt])
  @@index([firmId, logDate])
  @@index([firmId, status, logDate])
  @@map("machine_usage_logs")
}

// ---------------------------------------------------------------------------
// fleet_v2_cost: equipment cost tracking. SQL: prisma/pending/fleet_v2_cost/migration.sql
// CHECK constraints and partial indexes exist only in SQL (see that file): amounts >= 0, effectiveTo >= effectiveFrom,
// diesel rate/amount/source all-or-none, and the partial cost indexes on usage, diesel and cost entries.
// ---------------------------------------------------------------------------
enum MachineRateType {
  INTERNAL_HOURLY
  RENTAL
}

enum RateBasis {
  HOUR
  DAY
  MONTH
  KM
}

enum CostEntryCategory {
  OPERATOR
  TRANSPORT
  INSURANCE
  CONSUMABLES
  RENTAL_INVOICE
  OTHER
}

enum DieselRateSource {
  RECEIPT_AVG
  STORE
  DEFAULT
  MANUAL
}

enum WbsStatus {
  ACTIVE
  CLOSED
}

// One row per firm: shift length, idle threshold, default diesel price, working weekdays (ISO, 1 = Monday).
model FleetSettings {
  firmId              BigInt   @id
  standardHoursPerDay Decimal  @default(8) @db.Decimal(4, 2)
  idleAfterDays       Int      @default(2)
  defaultDieselRate   Decimal? @db.Decimal(10, 4)
  workingDays         Int[]    @default([1, 2, 3, 4, 5, 6])
  // fleet_v3_ops
  dayShiftStartMin            Int     @default(360)
  dayShiftEndMin              Int     @default(1080)
  blockWorkWhenServiceOverdue Boolean @default(false)
  countPendingLogsInTotals    Boolean @default(true)
  serviceLeadPercent          Int     @default(10)
  serviceLeadDays             Int     @default(7)
  documentExpiryWindowDays    Int     @default(30) // fleet_v4_documents
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  updatedById         BigInt?

  firm      Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("FleetSettingsUpdatedBy", fields: [updatedById], references: [id])

  @@map("fleet_settings")
}

// Work-breakdown activity that usage, diesel and cost entries are booked against.
model WbsActivity {
  id             String    @id @default(cuid())
  firmId         BigInt
  code           String
  name           String
  parentId       String?
  status         WbsStatus @default(ACTIVE)
  siteLocationId BigInt?
  defaultWorkTypeId String? // fleet_v3_ops
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  defaultWorkType WorkType? @relation("WbsDefaultWorkType", fields: [defaultWorkTypeId], references: [id])
  firm         Firm                 @relation(fields: [firmId], references: [id])
  parent       WbsActivity?         @relation("WbsTree", fields: [parentId], references: [id])
  children     WbsActivity[]        @relation("WbsTree")
  siteLocation SiteLocationDetails? @relation(fields: [siteLocationId], references: [id])
  usageLogs    MachineUsageLog[]
  dieselLogs   DieselLog[]
  costEntries  MachineCostEntry[]

  @@unique([firmId, code])
  @@index([firmId, status])
  @@map("wbs_activities")
}

// Effective-dated rate card. Append-only: a change adds a row with a later effectiveFrom and closes the previous one.
model MachineRate {
  id                  String          @id @default(cuid())
  firmId              BigInt
  machineId           String
  rateType            MachineRateType
  basis               RateBasis
  amount              Decimal         @db.Decimal(12, 4)
  minBillableQty      Decimal?        @db.Decimal(12, 2)
  extraRate           Decimal?        @db.Decimal(12, 4)
  deductBreakdownDays Boolean         @default(false)
  effectiveFrom       DateTime        @db.Date
  effectiveTo         DateTime?       @db.Date
  note                String?
  createdById         BigInt
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)

  firm      Firm    @relation(fields: [firmId], references: [id])
  machine   Machine @relation(fields: [machineId], references: [id])
  createdBy User    @relation("MachineRateCreatedBy", fields: [createdById], references: [id])

  @@unique([machineId, rateType, effectiveFrom])
  @@index([firmId, machineId])
  @@map("machine_rates")
}

// Manual costs booked to a machine (operator, transport, insurance, consumables, rental invoices, other).
model MachineCostEntry {
  id            String            @id @default(cuid())
  firmId        BigInt
  machineId     String
  costDate      DateTime          @db.Date // IST calendar day
  category      CostEntryCategory
  amount        Decimal           @db.Decimal(14, 2)
  wbsActivityId String?
  description   String?
  attachmentUrl String?
  createdById   BigInt
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  voidedAt      DateTime?         @db.Timestamptz(3)
  voidedById    BigInt?
  voidReason    String?

  firm        Firm         @relation(fields: [firmId], references: [id])
  machine     Machine      @relation(fields: [machineId], references: [id])
  wbsActivity WbsActivity? @relation(fields: [wbsActivityId], references: [id])
  createdBy   User         @relation("CostEntryCreatedBy", fields: [createdById], references: [id])
  voidedBy    User?        @relation("CostEntryVoidedBy", fields: [voidedById], references: [id])

  @@index([firmId, machineId, costDate])
  @@map("machine_cost_entries")
}


// ===================== FLEET v3: WORK LOGS, SERVICE, ASSIGNMENTS, TRANSFERS (fleet_v3_ops) =====================
// SQL: prisma/pending/fleet_v3_ops/migration.sql. Check constraints and partial unique indexes exist only in SQL:
//   machine_usage_logs: unique (firmId, clientRequestId) and (firmId, logNumber) where not null; CHECK reject needs a reason
//   maintenance_work_orders: one OPEN work order per scheduleId (partial unique)
//   machine_assignments: one ACTIVE (endedAt IS NULL) assignment per machine (partial unique)
//   machine_operator_assignments: one current operator per machine and shift (partial unique)
//   machine_transfers: one OPEN transfer per machine (partial unique); transferNumber unique

enum WorkShift {
  DAY
  NIGHT
  GENERAL
}

enum WorkLogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChecklistState {
  PENDING
  DONE
  ISSUE
}

enum ServiceMode {
  IN_HOUSE
  VENDOR
}

enum MachineDocType {
  RC_BOOK
  INSURANCE
  PUC
  FITNESS
  OPERATOR_LICENSE
  SERVICE_REPORT
  BILL
  OTHER
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model WorkLogStatusLog {
  id         String         @id @default(cuid())
  usageLogId String
  fromStatus WorkLogStatus?
  toStatus   WorkLogStatus
  actorId    BigInt?
  note       String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  usageLog MachineUsageLog @relation(fields: [usageLogId], references: [id], onDelete: Cascade)
  actor    User?           @relation("WorkLogStatusActor", fields: [actorId], references: [id])

  @@index([usageLogId, createdAt])
  @@map("work_log_status_logs")
}

model WorkType {
  id        String   @id @default(cuid())
  firmId    BigInt
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  firm          Firm              @relation(fields: [firmId], references: [id])
  usageLogs     MachineUsageLog[]
  wbsActivities WbsActivity[]     @relation("WbsDefaultWorkType")

  @@unique([firmId, name])
  @@map("work_types")
}

model ChecklistTemplate {
  id        String   @id @default(cuid())
  firmId    BigInt
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  firm      Firm                     @relation(fields: [firmId], references: [id])
  items     ChecklistTemplateItem[]
  schedules MachineServiceSchedule[]

  @@unique([firmId, name])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id         String @id @default(cuid())
  templateId String
  text       String
  sortOrder  Int    @default(0)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("checklist_template_items")
}

model MachineServiceSchedule {
  id                  String    @id @default(cuid())
  firmId              BigInt
  machineId           String
  name                String
  intervalValue       Decimal?  @db.Decimal(12, 2)
  intervalDays        Int?
  leadValue           Decimal?  @db.Decimal(12, 2)
  leadDays            Int?
  lastServiceAt       DateTime? @db.Date
  lastServiceReading  Decimal?  @db.Decimal(12, 2)
  checklistTemplateId String?
  isActive            Boolean   @default(true)
  createdById         BigInt?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  firm       Firm                   @relation(fields: [firmId], references: [id])
  machine    Machine                @relation(fields: [machineId], references: [id], onDelete: Cascade)
  template   ChecklistTemplate?     @relation(fields: [checklistTemplateId], references: [id])
  createdBy  User?                  @relation("ServiceScheduleCreatedBy", fields: [createdById], references: [id])
  workOrders MaintenanceWorkOrder[]

  @@index([machineId, isActive])
  @@index([firmId, isActive])
  @@map("machine_service_schedules")
}

model MachineDocument {
  id               String         @id @default(cuid())
  firmId           BigInt?
  machineId        String?
  workOrderId      String?
  type             MachineDocType @default(OTHER) // deprecated by fleet_v4_documents: documentTypeId is the type
  title            String
  url              String? // deprecated: files live in machine_document_files
  issuedAt         DateTime?      @db.Date
  expiresAt        DateTime?      @db.Date // deprecated: validTill
  createdById      BigInt?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  voidedAt         DateTime?      @db.Timestamptz(3)
  voidedById       BigInt?
  voidReason       String?
  // fleet_v4_documents
  documentTypeId   String
  ownerType        DocOwnerType   @default(MACHINE)
  ownerUserId      BigInt?
  documentNumber   String?
  issuer           String?
  validFrom        DateTime?      @db.Date
  validTill        DateTime?      @db.Date
  amount           Decimal?       @db.Decimal(14, 2)
  remarks          String?
  sourceType       DocSource      @default(UPLOAD)
  sourceRef        String?
  clientRequestId  String?
  renewsDocumentId String?
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  firm          Firm?                  @relation(fields: [firmId], references: [id])
  machine       Machine?               @relation(fields: [machineId], references: [id], onDelete: Cascade)
  workOrder     MaintenanceWorkOrder?  @relation(fields: [workOrderId], references: [id])
  createdBy     User?                  @relation("MachineDocCreatedBy", fields: [createdById], references: [id])
  voidedBy      User?                  @relation("MachineDocVoidedBy", fields: [voidedById], references: [id])
  documentType  DocumentType           @relation(fields: [documentTypeId], references: [id])
  ownerUser     User?                  @relation("MachineDocOwner", fields: [ownerUserId], references: [id])
  renews        MachineDocument?       @relation("DocRenewal", fields: [renewsDocumentId], references: [id])
  renewedBy     MachineDocument[]      @relation("DocRenewal")
  files         MachineDocumentFile[]
  events        MachineDocumentEvent[]

  @@index([machineId, type])
  @@map("machine_documents")
}

enum DocCategory {
  COMPLIANCE
  OPERATOR
  PURCHASE
  RENTAL
  SERVICE
  OTHER
}

enum DocValidity {
  REQUIRED
  OPTIONAL
  NONE
}

enum DocApplies {
  OWNED
  RENTED
  BOTH
}

enum DocOwnerType {
  MACHINE
  OPERATOR
}

enum DocSource {
  UPLOAD
  WORK_ORDER
  MIGRATED
}

enum DocEvent {
  CREATED
  UPDATED
  FILE_ADDED
  FILE_REPLACED
  VOIDED
  DOWNLOADED
}

// fleet_v4_documents. The unique index on (COALESCE(firmId,0), code) and the partial indexes on machine_documents exist only in SQL.
model DocumentType {
  id                 String      @id @default(cuid())
  firmId             BigInt?
  code               String
  name               String
  category           DocCategory
  hasValidity        DocValidity @default(NONE)
  appliesTo          DocApplies  @default(BOTH)
  machineCategories  String[]    @default([])
  singleCurrent      Boolean     @default(false)
  costSensitive      Boolean     @default(false)
  personal           Boolean     @default(false)
  allowMultipleFiles Boolean     @default(false)
  expiryLeadDays     Int?
  active             Boolean     @default(true)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)

  firm      Firm?             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  documents MachineDocument[]

  @@map("document_types")
}

model MachineDocumentFile {
  id           String   @id @default(cuid())
  documentId   String
  key          String
  url          String
  originalName String
  mimeType     String?
  sizeBytes    Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  document MachineDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sortOrder])
  @@index([key])
  @@map("machine_document_files")
}

model MachineDocumentEvent {
  id         String   @id @default(cuid())
  documentId String
  event      DocEvent
  actorId    BigInt?
  at         DateTime @default(now()) @db.Timestamptz(3)
  meta       Json?

  document MachineDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User?           @relation("DocEventActor", fields: [actorId], references: [id])

  @@index([documentId, at])
  @@map("machine_document_events")
}

model MachineAssignment {
  id                String    @id @default(cuid())
  machineId         String
  firmId            BigInt
  siteLocationId    BigInt?
  startedAt         DateTime  @default(now()) @db.Timestamptz(3)
  expectedReturnAt  DateTime? @db.Date
  endedAt           DateTime? @db.Timestamptz(3)
  endReason         String?
  responsibleUserId BigInt?
  note              String?
  createdById       BigInt?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  machine      Machine              @relation(fields: [machineId], references: [id], onDelete: Cascade)
  firm         Firm                 @relation(fields: [firmId], references: [id])
  siteLocation SiteLocationDetails? @relation(fields: [siteLocationId], references: [id])
  responsible  User?                @relation("AssignmentResponsible", fields: [responsibleUserId], references: [id])
  createdBy    User?                @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  transfers    MachineTransfer[]

  @@index([firmId, endedAt])
  @@index([machineId, startedAt])
  @@map("machine_assignments")
}

model MachineOperatorAssignment {
  id          String     @id @default(cuid())
  machineId   String
  userId      BigInt
  shift       WorkShift?
  validFrom   DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  validTill   DateTime?  @db.Date
  endedAt     DateTime?  @db.Timestamptz(3)
  createdById BigInt?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user      User    @relation("OperatorAssignmentUser", fields: [userId], references: [id])
  createdBy User?   @relation("OperatorAssignmentCreatedBy", fields: [createdById], references: [id])

  @@index([userId, endedAt])
  @@map("machine_operator_assignments")
}

model MachineTransfer {
  id                 String         @id @default(cuid())
  transferNumber     String         @unique
  machineId          String
  fromAssignmentId   String?
  fromFirmId         BigInt
  fromSiteLocationId BigInt?
  toFirmId           BigInt
  toSiteLocationId   BigInt?
  status             TransferStatus @default(REQUESTED)
  requestedById      BigInt?
  approvedById       BigInt?
  requestedAt        DateTime       @default(now()) @db.Timestamptz(3)
  dispatchedAt       DateTime?      @db.Timestamptz(3)
  transporter        String?
  vehicleNo          String?
  lrRef              String?
  eta                DateTime?      @db.Date
  receivedAt         DateTime?      @db.Timestamptz(3)
  receivedById       BigInt?
  cancelReason       String?
  note               String?

  machine        Machine                @relation(fields: [machineId], references: [id], onDelete: Cascade)
  fromAssignment MachineAssignment?     @relation(fields: [fromAssignmentId], references: [id])
  fromFirm       Firm                   @relation("TransferFromFirm", fields: [fromFirmId], references: [id])
  toFirm         Firm                   @relation("TransferToFirm", fields: [toFirmId], references: [id])
  requestedBy    User?                  @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy     User?                  @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  receivedBy     User?                  @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  events         MachineTransferEvent[]

  @@index([toFirmId, status])
  @@index([fromFirmId, status])
  @@map("machine_transfers")
}

model MachineTransferEvent {
  id         String          @id @default(cuid())
  transferId String
  fromStatus TransferStatus?
  toStatus   TransferStatus
  actorId    BigInt?
  note       String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  transfer MachineTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  actor    User?           @relation("TransferEventActor", fields: [actorId], references: [id])

  @@index([transferId, createdAt])
  @@map("machine_transfer_events")
}
