  holiday_ot_multiplier       Decimal  @default(2.0) @db.Decimal(5, 2)
  weekend_work_multiplier     Decimal  @default(1.5) @db.Decimal(5, 2)
  holiday_work_multiplier     Decimal  @default(2.0) @db.Decimal(5, 2)
  late_grace_minutes          Int      @default(15)
  late_deduct_type            String   @default("NONE") // PER_MINUTE, HALF_DAY, NONE
  half_day_after_late_minutes Int      @default(120)
  punch_mis_treatment         String   @default("HALF_DAY") // ABSENT, HALF_DAY, PRESENT
  pf_enabled                  Boolean  @default(true)
  pf_employee_rate            Decimal  @default(12) @db.Decimal(5, 2)
  pf_employer_rate            Decimal  @default(12) @db.Decimal(5, 2)
  esi_enabled                 Boolean  @default(true)
  esi_employee_rate           Decimal  @default(0.75) @db.Decimal(5, 2)
  esi_employer_rate           Decimal  @default(3.25) @db.Decimal(5, 2)
  esi_gross_limit             Decimal  @default(21000) @db.Decimal(12, 2)
  professional_tax_enabled    Boolean  @default(false)
  created_at                  DateTime @default(now()) @db.Timestamptz()
  updated_at                  DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@map("hr_pay_policy")
}

model HrLetterTemplate {
  id           BigInt               @id @default(autoincrement())
  name         String               @db.Text
  letter_type  String               @db.Text // OFFER, EXPERIENCE, JOINING
  content      String               @db.Text
  is_default   Boolean              @default(false)
  is_active    Boolean              @default(true)
  fields       Json?                @default("[]")
  created_at   DateTime             @default(now()) @db.Timestamptz()
  updated_at   DateTime             @default(now()) @updatedAt @db.Timestamptz()
  field_values HrLetterFieldValue[]

  @@index([letter_type])
  @@map("hr_letter_template")
}

model HrLetterFieldValue {
  id          BigInt   @id @default(autoincrement())
  template_id BigInt
  field_key   String   @db.Text
  value       String   @db.Text
  employee_id String   @default("") @db.Text // "" = global, or specific employee_id
  created_at  DateTime @default(now()) @db.Timestamptz()
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz()

  template HrLetterTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, field_key, employee_id])
  @@index([template_id])
  @@map("hr_letter_field_value")
}

model HrAuditEvent {
  id           BigInt   @id @default(autoincrement())
  entity_type  String   @db.Text // candidate, joining, attendance, leave, gatepass, advance, separation
  entity_id    String   @db.Text
  event_type   String   @db.Text
  performed_by String?  @db.Text
  notes        String?  @db.Text
  metadata     Json?
  created_at   DateTime @default(now()) @db.Timestamptz()

  @@index([entity_type, entity_id])
  @@index([event_type])
  @@map("hr_audit_event")
}

model HrConfig {
  key        String   @id @db.Text
  value      Json
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@map("hr_config")
}

model HrSocialAccount {
  id                BigInt  @id @default(autoincrement())
  platform          String  @unique @db.Text // LinkedIn, Facebook, Twitter, Instagram, YouTube
  handle            String  @db.Text
  profile_url       String? @db.Text
  status            String  @default("connected") // connected, disconnected
  auto_publish_jobs Boolean @default(true)
  track_referrals   Boolean @default(true)

  // Denormalized current stats, kept in sync by the /sync endpoint
  followers_num   Int       @default(0)
  growth_percent  Decimal   @default(0) @db.Decimal(6, 2)
  impressions_30d Int       @default(0)
  engagement_rate Decimal   @default(0) @db.Decimal(5, 2)
  job_clicks_30d  Int       @default(0)
  applicants_30d  Int       @default(0)
  last_synced_at  DateTime? @db.Timestamptz()

  connected_at DateTime @default(now()) @db.Timestamptz()
  created_at   DateTime @default(now()) @db.Timestamptz()
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz()

  posts     HrSocialPost[]
  snapshots HrSocialAnalyticsSnapshot[]

  @@index([status])
  @@map("hr_social_account")
}

model HrSocialPost {
  id           BigInt   @id @default(autoincrement())
  account_id   BigInt
  title        String   @db.Text
  type         String   @default("announcement") // job, announcement
  indent_id    String?  @db.Text // loose reference — indents live in hr_indents.json, not Postgres
  published_at DateTime @db.Timestamptz()
  views        Int      @default(0)
  clicks       Int      @default(0)
  applies      Int?
  likes        Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz()
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz()

  account HrSocialAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@map("hr_social_post")
}

model HrSocialAnalyticsSnapshot {
  id              BigInt   @id @default(autoincrement())
  account_id      BigInt
  followers_num   Int
  impressions_30d Int
  engagement_rate Decimal  @db.Decimal(5, 2)
  job_clicks_30d  Int
  applicants_30d  Int
  growth_percent  Decimal  @db.Decimal(6, 2) // vs previous snapshot, computed at insert time
  recorded_at     DateTime @default(now()) @db.Timestamptz()
  recorded_by     String?  @db.Text

  account HrSocialAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@map("hr_social_analytics_snapshot")
}

// ===================== ASSET / MAINTENANCE / REPAIR SYSTEM =====================
// See ASSET_MAINTENANCE_REPAIR_SCHEMA_ARCHITECTURE.md (repo root /md) for the full
// entity-relationship diagram, the rationale behind each design decision below, and
// the service-layer cascade rules these models replace fuzzy frontend string-matching
// with. Convention: new models use String cuid() ids / camelCase fields / createdAt
// timestamps (matching Petty Cash & Doc Sub-Manager), FK into the existing Firm /
// Department / Employee / User models rather than inventing parallel ones.

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_REPAIR
  DISPOSED
}

enum AssetCategory {
  IT
  ELECTRONICS
  FURNITURE
  MACHINERY
  TOOLS
  VEHICLE
}

enum AssetType {
  ASSET
  NON_CONSUMABLE
  CONSUMABLE
}

enum DepreciationMethod {
  STRAIGHT_LINE
  WDV
}

// Replaces three inconsistent priority<->number mappings found across the frontend
// (plansApi.ts, dashboardApi.ts, unique_task's edit-priority options all disagreed
// on what 1/2/3/4 meant) with one explicit enum.
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MachineStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  BREAKDOWN
  IDLE
  DECOMMISSIONED
}

enum MachineCategory {
  PRODUCTION
  UTILITY
  MATERIAL_HANDLING
  HVAC
  ELECTRICAL
  INSTRUMENTATION
  SAFETY
  FACILITY
}

enum PlanFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  FORTNIGHTLY
  ALTERNATE_DAYS
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  IN_FIRST_WEEK
  IN_SECOND_WEEK
  IN_THIRD_WEEK
  IN_FOURTH_WEEK
  RUNNING_HOURS
  METER_BASED
}

enum PlanHolidayAction {
  KEEP
  SKIP
  SHIFT_NEXT
  SHIFT_PREV
}

enum PlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  PENDING_APPROVAL
  COMPLETED
  COMPLETED_LATE
  COMPLETION_REJECTED
  OVERDUE
  ON_LEAVE
  MISSED
  SKIPPED
  CANCELLED
  ON_HOLD
}

enum WorkOrderType {
  SCHEDULED
  BREAKDOWN
  ONE_TIME
  REPAIR
}

enum TransferType {
  OCCURRENCE_TRANSFER
  PERMANENT_TRANSFER
  TEMPORARY_COVER
}

// Shared PENDING/APPROVED/REJECTED decision status — used by work-order approval
// requests and transfer requests alike.
enum ApprovalDecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BreakdownSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreakdownStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RepairIndentStatus {
  PENDING
  ASSIGNED
  SENT_FOR_REPAIR
  STORE_IN
  COMPLETED
  PAYMENT_DONE
}

// Split out of the frontend's overloaded `approvalStatus` field, which mixed an
// approve/reject decision with an inhouse/outhouse routing choice.
enum RepairRoutingType {
  INHOUSE
  OUTHOUSE
}

enum InspectionResult {
  PASS
  FAIL
  PENDING
}

enum StoreInStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum RepairPaymentMode {
  ONLINE_TRANSFER
  CHEQUE
  CASH
}

enum RepairPaymentStatus {
  FULLY_PAID
  PARTIAL
  PENDING_APPROVAL
}

enum AMCStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

// ----- Asset Management -----

model Asset {
  id                String        @id @default(cuid())
  firmId            BigInt?
  assetCode         String        @unique // stable internal code ("SN-0001"); generated via DocumentSequence, immutable after creation — this (or `id`) is the only field other systems should FK against, never `serialNo`/`productName`
  productName       String
  category          AssetCategory
  type              AssetType
  brand             String?
  model             String?
  serialNo          String? // manufacturer serial — free text, display-only, NOT used for cross-system matching
  sku               String?
  mfgDate           DateTime?
  origin            String?
  status            AssetStatus   @default(ACTIVE)
  assetDate         DateTime      @default(now())
  invoiceNo         String?
  cost              Decimal?      @db.Decimal(14, 2)
  quantity          Int           @default(1)
  supplierName      String?
  supplierPhone     String?
  paymentMode       String?
  location          String?
  department        String? // free text — the frontend has no department picker for assets, just a text input; not FK'd to Department (contrast with Machine/RepairIndent, which do use a real departmentId once those modules get their own picker UI)
  assignedTo        String? // free text — no employee picker in the Asset UI; see `department` note above
  responsiblePerson String? // free text — same as `assignedTo`
  warrantyAvailable Boolean       @default(false)
  warrantyEnd       DateTime?
  amcActive         Boolean       @default(false)
  amcEnd            DateTime?

  // --- Maintenance rollup cache: written by the maintenance service on WorkOrder
  // completion / MaintenancePlan creation. NOT the source of truth — Machine's own
  // plans/work orders are — see "Service-layer responsibilities" in the arch doc.
  maintenanceRequired Boolean        @default(false)
  maintenanceType     String?
  frequency           PlanFrequency?
  maintenanceCount    Int            @default(0)
  lastMaintenanceDate DateTime?
  nextService         DateTime?
  priority            Priority?

  // --- Repair rollup cache: written by the repair service on RepairIndent
  // completion. NOT the source of truth — RepairIndent rows are.
  repairCount     Int       @default(0)
  lastRepairDate  DateTime?
  lastRepairCost  Decimal?  @db.Decimal(14, 2) // cost of the most recent repair only — the frontend mock misleadingly called this `repairCost`
  totalRepairCost Decimal   @default(0) @db.Decimal(14, 2)
  partsChanged    Boolean   @default(false)

  assetValue  Decimal?            @db.Decimal(14, 2)
  depMethod   DepreciationMethod?
  createdById BigInt?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  firm          Firm?          @relation(fields: [firmId], references: [id])
  createdBy     User?          @relation(fields: [createdById], references: [id])
  machine       Machine?
  repairIndents RepairIndent[]
  amcContracts  AMCContract[]

  ownershipType OwnershipType @default(OWNED)

  @@index([firmId, ownershipType])

  @@index([firmId])
  @@index([status])
  @@map("assets")
}

// ----- Maintenance -----

model Machine {
  id               String          @id @default(cuid())
  firmId           BigInt?
  assetId          String?         @unique // 1:1 with Asset — nullable because not every asset is maintenance-tracked
  departmentId     BigInt?
  name             String
  assetCode        String          @unique // display code, copied from Asset.assetCode at creation time
  qrCode           String?
  serialNumber     String?
  modelNumber      String?
  manufacturer     String?
  supplier         String?
  category         MachineCategory
  subCategory      String?
  criticalityLevel Int             @default(1)
  location         String?
  locationCode     String?
  purchaseDate     DateTime?
  purchasePrice    Decimal?        @db.Decimal(14, 2)
  installationDate DateTime?
  warrantyExpiry   DateTime?
  status           MachineStatus   @default(OPERATIONAL)
  statusChangedAt  DateTime?
  runningHours     Decimal         @default(0) @db.Decimal(12, 2)
  specifications   Json?
  isActive         Boolean         @default(true)
  imageUrl         String?
  documentUrls     String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  firm             Firm?                  @relation(fields: [firmId], references: [id])
  asset            Asset?                 @relation(fields: [assetId], references: [id])
  department       Department?            @relation(fields: [departmentId], references: [id])
  parts            MachinePart[]
  maintenancePlans MaintenancePlan[]
  workOrders       MaintenanceWorkOrder[]
  breakdownReports BreakdownReport[]
  dailyLogs        DailyMachineLog[]
  repairIndents    RepairIndent[]
  amcContracts     AMCContract[]

  ownershipType       OwnershipType @default(OWNED)
  equipmentType       EquipmentType @default(OTHER)
  readingUnit         ReadingUnit   @default(HOURS)
  openingReading      Decimal       @default(0) @db.Decimal(12, 2)
  expectedConsumption Decimal?      @db.Decimal(8, 3)
  maxUsagePerEntry    Decimal?      @db.Decimal(10, 2)
  registrationNo      String?
  siteLocationId      BigInt?
  rentalStartAt       DateTime?     @db.Timestamptz(3)
  rentalEndAt         DateTime?     @db.Timestamptz(3)
  rentalVendorId      String?
  rentalVendorName    String?
  hireType            HireType?
  shiftHoursPerDay    Decimal?      @db.Decimal(4, 2) // per-machine override of the firm standard shift

  siteLocation SiteLocationDetails? @relation(fields: [siteLocationId], references: [id])
  rentalVendor RepairVendor?        @relation("MachineRentalVendor", fields: [rentalVendorId], references: [id])
  usageLogs    MachineUsageLog[]
  defaultMechanicId    BigInt?  // fleet_v3_ops
  defaultResponsibleId BigInt?
  capacityLabel        String?
  defaultMechanic      User? @relation("MachineDefaultMechanic", fields: [defaultMechanicId], references: [id])
  defaultResponsible   User? @relation("MachineDefaultResponsible", fields: [defaultResponsibleId], references: [id])
  serviceSchedules     MachineServiceSchedule[]
  documents            MachineDocument[]
  assignments          MachineAssignment[]
  operatorAssignments  MachineOperatorAssignment[]
  transfers            MachineTransfer[]
  dieselLogs   DieselLog[]
  rates        MachineRate[]
  costEntries  MachineCostEntry[]

  @@index([firmId, ownershipType])

  @@index([firmId])
  @@index([status])
  storeIssues Issue[] @relation("StoreIssueMachine") // store_issue_kind_v1

  @@map("machines")
}

model MachinePart {
  id          String   @id @default(cuid())
  machineId   String
  name        String
  partNumber  String?
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  machine          Machine                @relation(fields: [machineId], references: [id], onDelete: Cascade)
  maintenancePlans MaintenancePlan[]
  workOrders       MaintenanceWorkOrder[]
  repairIndents    RepairIndent[]
  repairParts      WorkOrderRepairPart[]

  @@index([machineId])
  @@map("machine_parts")
}

model ActivityType {
  id        String   @id @default(cuid())
  firmId    BigInt?
  name      String
  code      String?
  isSystem  Boolean  @default(false) // seeded/non-deletable system row vs firm-custom
  createdAt DateTime @default(now())

  firm  Firm?             @relation(fields: [firmId], references: [id])
  plans MaintenancePlan[]

  workOrders MaintenanceWorkOrder[]

  @@index([firmId])
  @@map("activity_types")
}

model MaintenancePlan {
  id                String            @id @default(cuid())
  firmId            BigInt?
  planCode          String?           @unique
  machineId         String
  activityTypeId    String?
  machinePartId     String?
  title             String
  description       String?
  documentUrl       String?
  frequency         PlanFrequency
  status            PlanStatus        @default(DRAFT)
  priority          Priority          @default(MEDIUM)
  estimatedMinutes  Int?
  onHoliday         PlanHolidayAction @default(SHIFT_NEXT)
  startDate         DateTime
  endDate           DateTime?
  triggerAfterHours Decimal?          @db.Decimal(10, 2) // RUNNING_HOURS frequency
  toleranceHours    Decimal?          @db.Decimal(10, 2)
  triggerAfterUnits Decimal?          @db.Decimal(10, 2) // METER_BASED frequency
  toleranceUnits    Decimal?          @db.Decimal(10, 2)
  assignedToUserId  BigInt?
  createdById       BigInt?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  firm         Firm?                  @relation(fields: [firmId], references: [id])
  machine      Machine                @relation(fields: [machineId], references: [id])
  activityType ActivityType?          @relation(fields: [activityTypeId], references: [id])
  machinePart  MachinePart?           @relation(fields: [machinePartId], references: [id])
  assignedTo   User?                  @relation("PlanAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy    User?                  @relation("PlanCreatedBy", fields: [createdById], references: [id])
  workOrders   MaintenanceWorkOrder[]

  @@index([machineId])
  @@index([firmId])
  @@map("maintenance_plans")
}

model MaintenanceWorkOrder {
  id                    String          @id @default(cuid())
  firmId                BigInt?
  workOrderCode         String?         @unique
  planId                String? // null for BREAKDOWN/ONE_TIME/REPAIR work orders
  machineId             String
  machinePartId         String?
  breakdownReportId     String?         @unique // set when type = BREAKDOWN
  currentAssigneeUserId BigInt?
  completedByUserId     BigInt?
  type                  WorkOrderType
  status                WorkOrderStatus @default(PENDING)
  priority              Priority        @default(MEDIUM)
  scheduledDate         DateTime?
  actualDueDate         DateTime
  wasShifted            Boolean         @default(false)
  startedAt             DateTime?
  completedAt           DateTime?
  skipReason            String?
  cancelReason          String?
  completionNote        String?
  actualMinutesTaken    Int?
  slaBreach             Boolean         @default(false)
  escalationLevel       Int             @default(0)
  cost                  Decimal?        @db.Decimal(12, 2) // set by processRepair's billAmount — backs the cost-analysis report
  photoUrl              String? // presigned-S3 URL of the work photo attached via processRepair
  billUrl               String? // presigned-S3 URL of the bill copy attached via processRepair
  typeOfWork            String? // in_house or out_source set via processRepair
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  firm             Firm?                      @relation(fields: [firmId], references: [id])
  plan             MaintenancePlan?           @relation(fields: [planId], references: [id])
  machine          Machine                    @relation(fields: [machineId], references: [id])
  machinePart      MachinePart?               @relation(fields: [machinePartId], references: [id])
  breakdownReport  BreakdownReport?           @relation(fields: [breakdownReportId], references: [id])
  currentAssignee  User?                      @relation("WorkOrderCurrentAssignee", fields: [currentAssigneeUserId], references: [id])
  completedBy      User?                      @relation("WorkOrderCompletedBy", fields: [completedByUserId], references: [id])
  checklistItems   WorkOrderChecklistItem[]
  replacementParts WorkOrderReplacementPart[]
  repairParts      WorkOrderRepairPart[]
  approvalRequests WorkOrderApprovalRequest[]
  transfers        WorkOrderTransfer[]
  statusLogs       WorkOrderStatusLog[]
  repairIndents    RepairIndent[]

  title           String?
  description     String?
  activityTypeId  String?
  documentUrl     String?
  requestedById   BigInt?
  outsourceStatus OutsourceStatus?
  vendorId        String?
  sentAt          DateTime?        @db.Timestamptz(3)
  receivedAt      DateTime?        @db.Timestamptz(3)
  paidAt          DateTime?        @db.Timestamptz(3)
  billNo          String?
  rollupAppliedAt DateTime?        @db.Timestamptz(3)

  // fleet_v3_ops: task assignment, service link, estimate / actual split. `cost` stays the single actual total.
  responsibleId    BigInt?
  serviceMode      ServiceMode @default(IN_HOUSE)
  scheduleId       String?
  readingAtService Decimal?    @db.Decimal(12, 2)
  estPartsCost     Decimal?    @db.Decimal(14, 2)
  estLabourCost    Decimal?    @db.Decimal(14, 2)
  actualPartsCost  Decimal?    @db.Decimal(14, 2)
  actualLabourCost Decimal?    @db.Decimal(14, 2)

  responsible User?                   @relation("WorkOrderResponsible", fields: [responsibleId], references: [id])
  schedule    MachineServiceSchedule? @relation(fields: [scheduleId], references: [id])
  documents   MachineDocument[]

  activityType ActivityType? @relation(fields: [activityTypeId], references: [id])
  requestedBy  User?         @relation("WorkOrderRequestedBy", fields: [requestedById], references: [id])
  vendor       RepairVendor? @relation("WorkOrderVendor", fields: [vendorId], references: [id])

  @@index([outsourceStatus])
  @@index([responsibleId])
  @@index([scheduleId])
  @@index([machineId, completedAt])
  @@index([firmId, completedAt])

  @@index([machineId])
  @@index([firmId])
  @@index([status])
  storeIssues Issue[] @relation("StoreIssueWorkOrder") // store_issue_kind_v1

  // fleet_v7_repair_parts: NULL = not decided (old orders), true / false = in-house "material required?" answer
  materialRequired Boolean?
  partRequirements WorkOrderPartRequirement[]
  partIssues       WorkOrderPartIssue[]
  indents          Indent[] @relation("IndentWorkOrder")

  @@map("maintenance_work_orders")
}

// Structured replacement for the frontend's untyped `checklistResponses` JSON blob.
model WorkOrderChecklistItem {
  id          String  @id @default(cuid())
  workOrderId String
  text        String
  done        Boolean @default(false)
  sortOrder   Int     @default(0)
  // fleet_v3_ops: Done / Pending / Issue with who and when. `done` is kept in sync (done = state is DONE).
  state    ChecklistState @default(PENDING)
  note     String?
  doneById BigInt?
  doneAt   DateTime?      @db.Timestamptz(3)
  photoUrl String?

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  doneBy    User?                @relation("ChecklistItemDoneBy", fields: [doneById], references: [id])

  @@index([workOrderId])
  @@map("work_order_checklist_items")
}

model WorkOrderReplacementPart {
  id          String   @id @default(cuid())
  workOrderId String
  name        String
  quantity    Int      @default(1)
  cost        Decimal? @db.Decimal(12, 2)

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_replacement_parts")
}

// Parts consumed during a maintenance-side repair (WorkOrder.type = REPAIR/BREAKDOWN).
// Also what Asset.partsChanged/totalRepairCost should be derived from instead of the
// frontend's deduped `partNames: string[]` array.
model WorkOrderRepairPart {
  id               String    @id @default(cuid())
  workOrderId      String
  partName         String
  quantity         Int       @default(1)
  vendorName       String?
  warrantyFromDate DateTime?
  warrantyToDate   DateTime?
  unitCost         Decimal?  @db.Decimal(12, 2) // fleet_v3_ops
  machinePartId    String?

  workOrder   MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  machinePart MachinePart?         @relation(fields: [machinePartId], references: [id])

  @@index([workOrderId])
  @@map("work_order_repair_parts")
}

// fleet_v7_repair_parts: a part (Store item) an in-house repair needs. Issued quantity is derived from live WorkOrderPartIssue rows.
model WorkOrderPartRequirement {
  id           String    @id @default(cuid())
  workOrderId  String
  firmId       BigInt?
  itemId       BigInt?
  itemName     String
  groupHead    String
  uom          String?
  quantity     Decimal   @db.Decimal(12, 3)
  note         String?
  indentNumber String?
  status       String    @default("OPEN") // OPEN | CANCELLED
  createdById  BigInt?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)
  cancelReason String?

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  item      Item?                @relation("PartRequirementItem", fields: [itemId], references: [id], onDelete: SetNull)
  issues    WorkOrderPartIssue[]
  indents   Indent[]             @relation("IndentPartRequirement")
  storeIssues Issue[]            @relation("IssuePartRequirement")

  @@index([workOrderId], map: "work_order_part_requirements_wo_idx")
  @@map("work_order_part_requirements")
}

// fleet_v7_repair_parts: one live row per approved Store issue (void on reset / reject / delete).
model WorkOrderPartIssue {
  id            String    @id @default(cuid())
  requirementId String
  workOrderId   String
  storeIssueId  BigInt?
  quantity      Decimal   @db.Decimal(12, 3)
  unitCost      Decimal?  @db.Decimal(14, 4)
  amount        Decimal?  @db.Decimal(14, 2)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  voidedAt      DateTime? @db.Timestamptz(3)
  voidReason    String?

  requirement WorkOrderPartRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  workOrder   MaintenanceWorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  storeIssue  Issue?                   @relation("StoreIssuePartIssue", fields: [storeIssueId], references: [id], onDelete: SetNull)

  @@index([workOrderId], map: "work_order_part_issues_wo_idx")
  @@index([requirementId], map: "work_order_part_issues_req_idx")
  @@map("work_order_part_issues")
}

model WorkOrderApprovalRequest {
