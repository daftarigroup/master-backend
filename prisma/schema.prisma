model Received {
  id                  BigInt   @id @default(autoincrement())
  timestamp           DateTime @default(now()) @db.Timestamptz()
  indent_number       String?  @db.Text
  po_date             String?  @db.Text
  po_number           String?  @db.Text
  vendor              String?  @db.Text
