  followers_num   Int
  impressions_30d Int
  engagement_rate Decimal  @db.Decimal(5, 2)
  job_clicks_30d  Int
  applicants_30d  Int
  growth_percent  Decimal  @db.Decimal(6, 2) // vs previous snapshot, computed at insert time
  recorded_at     DateTime @default(now()) @db.Timestamptz()
