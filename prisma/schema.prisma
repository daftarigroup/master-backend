// Prisma Schema for Store App (Refactored from master-frontend/database/store_schema.sql)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccessType {
  VIEW
  EDIT
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum TaskStatus {
  pending
  done
  extend
  extended
  approved
  rejected
}

model AreaOfUse {
  id         BigInt   @id @default(autoincrement())
  name       String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz()
  firm_id    BigInt?
  firm_name  String?  @db.Text
  firm       Firm?    @relation(fields: [firm_id], references: [id])

  @@map("area_of_use")
}

model Company {
  id                  BigInt   @id @default(autoincrement())
  company_name        String   @db.Text
  gstin               String?  @db.Text
  pan                 String?  @db.Text
  email               String?  @db.Text
  phone               String?  @db.Text
  address             String?  @db.Text
  contact_person      String?  @db.Text
  created_at          DateTime @default(now()) @db.Timestamptz()
  updated_at          DateTime @default(now()) @db.Timestamptz()
  billing_address     String?  @db.Text
  destination_address String?  @db.Text
  firm_id             BigInt?
  firm_name           String?  @db.Text
  firm_rel            Firm?    @relation("company_firm", fields: [firm_id], references: [id])
  firm                Firm[]

  @@map("company")
}

model ContractorDetails {
  id                 BigInt    @id @default(autoincrement())
  created_at         DateTime? @default(now()) @db.Timestamptz()
  contractor_name    String    @db.Text
  contractor_gstin   String?   @db.Text
  contractor_address String?   @db.Text
  contractor_email   String?   @db.Text
  responsible_person String?   @db.Text
  location           String?   @db.Text
  phone              String?   @db.Text
  firm_id            BigInt?
  firm_name          String?   @db.Text
  firm               Firm?     @relation(fields: [firm_id], references: [id])

  @@map("contractor_details")
}

model DefaultPoTerms {
  id         BigInt   @id @default(autoincrement())
  term_text  String   @db.Text
  sort_order Int?
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz()
  firm_id    BigInt?
  firm_name  String?  @db.Text
  firm       Firm?    @relation(fields: [firm_id], references: [id])

  @@map("default_po_terms")
}

model Department {
  id         BigInt     @id @default(autoincrement())
  name       String     @db.Text
  created_at DateTime   @default(now()) @db.Timestamptz()
  employees  Employee[]

  // Asset / Maintenance / Repair system
  machines       Machine[]
  repair_indents RepairIndent[]
  technicians    Technician[]

  @@map("department")
}

model Firm {
  id                           BigInt                @id @default(autoincrement())
  company_id                   BigInt?
  firm_name                    String                @db.Text
  billing_address              String?               @db.Text
  destination_address          String?               @db.Text
  contact_person               String?               @db.Text
  active                       Boolean               @default(true)
  created_at                   DateTime              @default(now()) @db.Timestamptz()
  updated_at                   DateTime              @default(now()) @db.Timestamptz()
  company                      Company?              @relation(fields: [company_id], references: [id])
  fullkitting                  Fullkitting[]
  indent                       Indent[]
  inventory                    Inventory[]
  issue                        Issue[]
  payment_history              PaymentHistory[]
  payments                     Payments[]
  po_master                    PoMaster[]
  quotation_history            QuotationHistory[]
  stock_transfers_from_firm_id StockTransfers[]      @relation("from_firm_id")
  stock_transfers_to_firm_id   StockTransfers[]      @relation("to_firm_id")
  store_in                     StoreIn[]
  store_in_direct              StoreInDirect[]
  tally_entry                  TallyEntry[]
  item                         Item[]
  checklist_task               ChecklistTask[]
  delegation_task              DelegationTask[]
  area_of_use                  AreaOfUse[]
  company_records              Company[]             @relation("company_firm")
  contractor_details           ContractorDetails[]
  default_po_terms             DefaultPoTerms[]
  group_head                   GroupHead[]
  site_engineer_details        SiteEngineerDetails[]
  site_location_details        SiteLocationDetails[]
  terms_and_condition          TermsAndCondition[]
  uom                          Uom[]
  vendors                      Vendors[]
  project_assignments          ProjectAssignment[]
  employees                    Employee[]            @relation("EmployeeHomeFirm")

  // Asset / Maintenance / Repair system
  assets                  Asset[]
  machines                Machine[]
  activity_types          ActivityType[]
  maintenance_plans       MaintenancePlan[]
  maintenance_work_orders MaintenanceWorkOrder[]
  breakdown_reports       BreakdownReport[]
  daily_machine_logs      DailyMachineLog[]
  repair_vendors          RepairVendor[]
  spare_parts             SparePart[]
  repair_indents          RepairIndent[]
  technicians             Technician[]
  amc_contracts           AMCContract[]
  document_sequences      DocumentSequence[]

  @@map("firm")
}

model Fullkitting {
  id                    BigInt    @id @default(autoincrement())
  timestamp             DateTime  @db.Timestamp()
  indent_number         String?   @db.Text
  vendor_name           String?   @db.Text
  product_name          String?   @db.Text
  qty                   String?   @db.Text
  bill_no               String?   @db.Text
  transporting_include  String?   @db.Text
  transporter_name      String?   @db.Text
  amount                String?   @db.Text
  vehical_no            String?   @db.Text
  driver_name           String?   @db.Text
  driver_mobile_no      String?   @db.Text
  planned               DateTime? @db.Timestamp()
  actual                DateTime? @db.Timestamp()
  time_delay            String?   @db.Text
  fms_name_match        String?   @db.Text
  status                String?   @db.Text
  vehicle_number        String?   @db.Text
  from                  String?   @db.Text
  to                    String?   @db.Text
  material_load_details String?   @db.Text
  bilty_number          String?   @db.Text
  rate_type             String?   @db.Text
  amount1               String?   @db.Text
  bilty_image           String?   @db.Text
  firm_name             String?   @db.Text
  firm_id               BigInt?
  firm                  Firm?     @relation(fields: [firm_id], references: [id])

  @@map("fullkitting")
}

model GroupHead {
  id         BigInt   @id @default(autoincrement())
  name       String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz()
  firm_id    BigInt?
  firm_name  String?  @db.Text
  firm       Firm?    @relation(fields: [firm_id], references: [id])
  item       Item[]

  @@map("group_head")
}

