}

model SiteEngineerDetails {
  id     Int     @id @default(autoincrement())
  name   String  @db.Text
  number String  @db.Text
  email  String? @db.Text

  @@map("site_engineer_details")
}

model SiteLocationDetails {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamptz()
  location   String    @db.Text

  @@map("site_location_details")
}

model Stock {
  id            BigInt   @id @default(autoincrement())
  timestamp     DateTime @default(now()) @db.Timestamptz()
  serial_number String?  @db.Text
  group_head    String?  @db.Text
  product_name  String?  @db.Text
  uom           String?  @db.Text
  opening       Decimal?
  min_level     Decimal?
  latest_price  Decimal?
  intransit     Decimal?
  received      Decimal?
  consumed      Decimal?
  current_stock Decimal?
  value         Decimal?
  required      Decimal?
  condition     String?  @db.Text

  @@map("stock")
}

model StockTransfers {
  id           BigInt    @id @default(autoincrement())
  timestamp    DateTime? @default(now()) @db.Timestamptz()
  transfer_no  String    @db.Text
  from_project String    @db.Text
  to_project   String    @db.Text
  product_name String    @db.Text
  uom          String?   @db.Text
  group_head   String?   @db.Text
  quantity     Decimal
  remark       String?   @default("Internal Stock Transfer") @db.Text
  status       String?   @default("Approved") @db.Text
  from_firm_id BigInt?
  to_firm_id   BigInt?
  from_firm    Firm?     @relation("from_firm_id", fields: [from_firm_id], references: [id])
  to_firm      Firm?     @relation("to_firm_id", fields: [to_firm_id], references: [id])

  @@map("stock_transfers")
}

model StoreIn {
  id                         BigInt    @id @default(autoincrement())
  timestamp                  DateTime  @db.Timestamptz()
  lift_number                String?   @db.Text
  indent_no                  String?   @db.Text
  po_number                  String?   @db.Text
  vendor_name                String?   @db.Text
  product_name               String?   @db.Text
  bill_status                String?   @db.Text
  bill_no                    String?   @db.Text
  qty                        String?   @db.Text
  lead_time_to_lift_material String?   @db.Text
  type_of_bill               String?   @db.Text
  bill_amount                String?   @db.Text
  discount_amount            String?   @db.Text
  payment_type               String?   @db.Text
  advance_amount_if_any      String?   @db.Text
