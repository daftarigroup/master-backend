  warranty_status     String?  @db.Text
  end_date            String?  @db.Text
  bill_status         String?  @db.Text
  bill_number         String?  @db.Text
  bill_amount         String?  @db.Text
  photo_of_bill       String?  @db.Text
  any_transportations String?  @db.Text
  transporter_name    String?  @db.Text
  transporting_amount String?  @db.Text

  @@map("received")
}

model SiteEngineerDetails {
  id        Int     @id @default(autoincrement())
  name      String  @db.Text
  number    String  @db.Text
  email     String? @db.Text
  firm_id   BigInt?
  firm_name String? @db.Text
  firm      Firm?   @relation(fields: [firm_id], references: [id])

  @@map("site_engineer_details")
}

model SiteLocationDetails {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamptz()
  location   String    @db.Text
  firm_id    BigInt?
  firm_name  String?   @db.Text
  firm       Firm?     @relation(fields: [firm_id], references: [id])

  @@map("site_location_details")
}

model Stock {
  id            BigInt   @id @default(autoincrement())
  timestamp     DateTime @default(now()) @db.Timestamptz()
  serial_number String?  @db.Text
  group_head    String?  @db.Text
  product_name  String?  @db.Text
  uom           String?  @db.Text
  opening       Decimal?
  min_level     Decimal?
  latest_price  Decimal?
  intransit     Decimal?
  received      Decimal?
  consumed      Decimal?
  current_stock Decimal?
  value         Decimal?
  required      Decimal?
  condition     String?  @db.Text

  @@map("stock")
}

