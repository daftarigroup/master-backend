  token          String?
  vendor_rate    Decimal?
  responded_at   DateTime? @db.Timestamptz()
  vendor_remarks String?   @db.Text
  firm_id        BigInt?
  firm_rel       Firm?     @relation(fields: [firm_id], references: [id])

  @@map("quotation_history")
}

model Received {
  id                  BigInt   @id @default(autoincrement())
  timestamp           DateTime @default(now()) @db.Timestamptz()
  indent_number       String?  @db.Text
  po_date             String?  @db.Text
  po_number           String?  @db.Text
  vendor              String?  @db.Text
  received_status     String?  @db.Text
  received_quantity   String?  @db.Text
  uom                 String?  @db.Text
  photo_of_product    String?  @db.Text
  warranty_status     String?  @db.Text
