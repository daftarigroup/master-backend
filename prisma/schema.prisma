// See ASSET_MAINTENANCE_REPAIR_SCHEMA_ARCHITECTURE.md (repo root /md) for the full
// entity-relationship diagram, the rationale behind each design decision below, and
// the service-layer cascade rules these models replace fuzzy frontend string-matching
// with. Convention: new models use String cuid() ids / camelCase fields / createdAt
// timestamps (matching Petty Cash & Doc Sub-Manager), FK into the existing Firm /
// Department / Employee / User models rather than inventing parallel ones.

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_REPAIR
  DISPOSED
}

enum AssetCategory {
  IT
  ELECTRONICS
  FURNITURE
  MACHINERY
  TOOLS
  VEHICLE
}

enum AssetType {
  ASSET
  NON_CONSUMABLE
  CONSUMABLE
}

enum DepreciationMethod {
  STRAIGHT_LINE
  WDV
}

// Replaces three inconsistent priority<->number mappings found across the frontend
// (plansApi.ts, dashboardApi.ts, unique_task's edit-priority options all disagreed
// on what 1/2/3/4 meant) with one explicit enum.
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MachineStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  BREAKDOWN
  IDLE
  DECOMMISSIONED
}

enum MachineCategory {
  PRODUCTION
  UTILITY
  MATERIAL_HANDLING
  HVAC
  ELECTRICAL
  INSTRUMENTATION
  SAFETY
  FACILITY
}

enum PlanFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  FORTNIGHTLY
  ALTERNATE_DAYS
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  IN_FIRST_WEEK
  IN_SECOND_WEEK
  IN_THIRD_WEEK
  IN_FOURTH_WEEK
  RUNNING_HOURS
  METER_BASED
}

enum PlanHolidayAction {
  KEEP
  SKIP
  SHIFT_NEXT
  SHIFT_PREV
}

enum PlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  PENDING_APPROVAL
  COMPLETED
  COMPLETED_LATE
  COMPLETION_REJECTED
  OVERDUE
  ON_LEAVE
  MISSED
  SKIPPED
  CANCELLED
  ON_HOLD
}

enum WorkOrderType {
  SCHEDULED
  BREAKDOWN
  ONE_TIME
  REPAIR
}

enum TransferType {
  OCCURRENCE_TRANSFER
  PERMANENT_TRANSFER
  TEMPORARY_COVER
}

// Shared PENDING/APPROVED/REJECTED decision status — used by work-order approval
// requests and transfer requests alike.
enum ApprovalDecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BreakdownSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreakdownStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RepairIndentStatus {
  PENDING
  ASSIGNED
  SENT_FOR_REPAIR
  STORE_IN
  COMPLETED
  PAYMENT_DONE
}

// Split out of the frontend's overloaded `approvalStatus` field, which mixed an
// approve/reject decision with an inhouse/outhouse routing choice.
enum RepairRoutingType {
  INHOUSE
  OUTHOUSE
}

enum InspectionResult {
  PASS
  FAIL
  PENDING
}

enum StoreInStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum RepairPaymentMode {
  ONLINE_TRANSFER
  CHEQUE
  CASH
}

enum RepairPaymentStatus {
  FULLY_PAID
  PARTIAL
  PENDING_APPROVAL
}

enum AMCStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

// ----- Asset Management -----

model Asset {
  id                String        @id @default(cuid())
  firmId            BigInt?
  assetCode         String        @unique // stable internal code ("SN-0001"); generated via DocumentSequence, immutable after creation — this (or `id`) is the only field other systems should FK against, never `serialNo`/`productName`
  productName       String
  category          AssetCategory
  type              AssetType
  brand             String?
  model             String?
  serialNo          String? // manufacturer serial — free text, display-only, NOT used for cross-system matching
  sku               String?
  mfgDate           DateTime?
  origin            String?
  status            AssetStatus   @default(ACTIVE)
  assetDate         DateTime      @default(now())
  invoiceNo         String?
  cost              Decimal?      @db.Decimal(14, 2)
  quantity          Int           @default(1)
  supplierName      String?
  supplierPhone     String?
  paymentMode       String?
  location          String?
  department        String? // free text — the frontend has no department picker for assets, just a text input; not FK'd to Department (contrast with Machine/RepairIndent, which do use a real departmentId once those modules get their own picker UI)
  assignedTo        String? // free text — no employee picker in the Asset UI; see `department` note above
  responsiblePerson String? // free text — same as `assignedTo`
  warrantyAvailable Boolean       @default(false)
  warrantyEnd       DateTime?
  amcActive         Boolean       @default(false)
  amcEnd            DateTime?

  // --- Maintenance rollup cache: written by the maintenance service on WorkOrder
  // completion / MaintenancePlan creation. NOT the source of truth — Machine's own
  // plans/work orders are — see "Service-layer responsibilities" in the arch doc.
  maintenanceRequired Boolean        @default(false)
  maintenanceType     String?
  frequency           PlanFrequency?
  maintenanceCount    Int            @default(0)
  lastMaintenanceDate DateTime?
  nextService         DateTime?
  priority            Priority?

  // --- Repair rollup cache: written by the repair service on RepairIndent
  // completion. NOT the source of truth — RepairIndent rows are.
  repairCount     Int       @default(0)
  lastRepairDate  DateTime?
  lastRepairCost  Decimal?  @db.Decimal(14, 2) // cost of the most recent repair only — the frontend mock misleadingly called this `repairCost`
  totalRepairCost Decimal   @default(0) @db.Decimal(14, 2)
  partsChanged    Boolean   @default(false)

  assetValue  Decimal?            @db.Decimal(14, 2)
  depMethod   DepreciationMethod?
  createdById BigInt?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  firm          Firm?          @relation(fields: [firmId], references: [id])
  createdBy     User?          @relation(fields: [createdById], references: [id])
  machine       Machine?
  repairIndents RepairIndent[]
  amcContracts  AMCContract[]

  @@index([firmId])
  @@index([status])
  @@map("assets")
}

// ----- Maintenance -----

model Machine {
  id               String          @id @default(cuid())
  firmId           BigInt?
  assetId          String?         @unique // 1:1 with Asset — nullable because not every asset is maintenance-tracked
  departmentId     BigInt?
  name             String
  assetCode        String          @unique // display code, copied from Asset.assetCode at creation time
  qrCode           String?
  serialNumber     String?
  modelNumber      String?
  manufacturer     String?
  supplier         String?
  category         MachineCategory
  subCategory      String?
  criticalityLevel Int             @default(1)
  location         String?
  locationCode     String?
  purchaseDate     DateTime?
  purchasePrice    Decimal?        @db.Decimal(14, 2)
  installationDate DateTime?
  warrantyExpiry   DateTime?
  status           MachineStatus   @default(OPERATIONAL)
  statusChangedAt  DateTime?
  runningHours     Decimal         @default(0) @db.Decimal(12, 2)
  specifications   Json?
  isActive         Boolean         @default(true)
  imageUrl         String?
  documentUrls     String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  firm             Firm?                  @relation(fields: [firmId], references: [id])
  asset            Asset?                 @relation(fields: [assetId], references: [id])
  department       Department?            @relation(fields: [departmentId], references: [id])
  parts            MachinePart[]
  maintenancePlans MaintenancePlan[]
  workOrders       MaintenanceWorkOrder[]
  breakdownReports BreakdownReport[]
  dailyLogs        DailyMachineLog[]
  repairIndents    RepairIndent[]
  amcContracts     AMCContract[]

  @@index([firmId])
  @@index([status])
  @@map("machines")
}

model MachinePart {
  id          String   @id @default(cuid())
  machineId   String
  name        String
  partNumber  String?
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  machine          Machine                @relation(fields: [machineId], references: [id], onDelete: Cascade)
  maintenancePlans MaintenancePlan[]
  workOrders       MaintenanceWorkOrder[]
  repairIndents    RepairIndent[]

  @@index([machineId])
  @@map("machine_parts")
}

model ActivityType {
  id        String   @id @default(cuid())
  firmId    BigInt?
  name      String
  code      String?
  isSystem  Boolean  @default(false) // seeded/non-deletable system row vs firm-custom
  createdAt DateTime @default(now())

  firm  Firm?             @relation(fields: [firmId], references: [id])
  plans MaintenancePlan[]

  @@index([firmId])
  @@map("activity_types")
}

model MaintenancePlan {
  id                String            @id @default(cuid())
  firmId            BigInt?
  planCode          String?           @unique
  machineId         String
  activityTypeId    String?
  machinePartId     String?
  title             String
  description       String?
  documentUrl       String?
  frequency         PlanFrequency
  status            PlanStatus        @default(DRAFT)
  priority          Priority          @default(MEDIUM)
  estimatedMinutes  Int?
  onHoliday         PlanHolidayAction @default(SHIFT_NEXT)
  startDate         DateTime
  endDate           DateTime?
  triggerAfterHours Decimal?          @db.Decimal(10, 2) // RUNNING_HOURS frequency
  toleranceHours    Decimal?          @db.Decimal(10, 2)
  triggerAfterUnits Decimal?          @db.Decimal(10, 2) // METER_BASED frequency
  toleranceUnits    Decimal?          @db.Decimal(10, 2)
  assignedToUserId  BigInt?
  createdById       BigInt?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  firm         Firm?                  @relation(fields: [firmId], references: [id])
  machine      Machine                @relation(fields: [machineId], references: [id])
  activityType ActivityType?          @relation(fields: [activityTypeId], references: [id])
  machinePart  MachinePart?           @relation(fields: [machinePartId], references: [id])
  assignedTo   User?                  @relation("PlanAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy    User?                  @relation("PlanCreatedBy", fields: [createdById], references: [id])
  workOrders   MaintenanceWorkOrder[]

  @@index([machineId])
  @@index([firmId])
  @@map("maintenance_plans")
}

model MaintenanceWorkOrder {
  id                    String          @id @default(cuid())
  firmId                BigInt?
  workOrderCode         String?         @unique
  planId                String? // null for BREAKDOWN/ONE_TIME/REPAIR work orders
  machineId             String
  machinePartId         String?
  breakdownReportId     String?         @unique // set when type = BREAKDOWN
  currentAssigneeUserId BigInt?
  completedByUserId     BigInt?
  type                  WorkOrderType
  status                WorkOrderStatus @default(PENDING)
  priority              Priority        @default(MEDIUM)
  scheduledDate         DateTime?
  actualDueDate         DateTime
  wasShifted            Boolean         @default(false)
  startedAt             DateTime?
  completedAt           DateTime?
  skipReason            String?
  cancelReason          String?
  completionNote        String?
  actualMinutesTaken    Int?
  slaBreach             Boolean         @default(false)
  escalationLevel       Int             @default(0)
  cost                  Decimal?        @db.Decimal(12, 2) // set by processRepair's billAmount — backs the cost-analysis report
  photoUrl              String? // presigned-S3 URL of the work photo attached via processRepair
  billUrl               String? // presigned-S3 URL of the bill copy attached via processRepair
  typeOfWork            String? // in_house or out_source set via processRepair
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  firm             Firm?                      @relation(fields: [firmId], references: [id])
  plan             MaintenancePlan?           @relation(fields: [planId], references: [id])
  machine          Machine                    @relation(fields: [machineId], references: [id])
  machinePart      MachinePart?               @relation(fields: [machinePartId], references: [id])
  breakdownReport  BreakdownReport?           @relation(fields: [breakdownReportId], references: [id])
  currentAssignee  User?                      @relation("WorkOrderCurrentAssignee", fields: [currentAssigneeUserId], references: [id])
  completedBy      User?                      @relation("WorkOrderCompletedBy", fields: [completedByUserId], references: [id])
  checklistItems   WorkOrderChecklistItem[]
  replacementParts WorkOrderReplacementPart[]
  repairParts      WorkOrderRepairPart[]
  approvalRequests WorkOrderApprovalRequest[]
  transfers        WorkOrderTransfer[]
  statusLogs       WorkOrderStatusLog[]
  repairIndents    RepairIndent[]

  @@index([machineId])
  @@index([firmId])
  @@index([status])
  @@map("maintenance_work_orders")
}

// Structured replacement for the frontend's untyped `checklistResponses` JSON blob.
model WorkOrderChecklistItem {
  id          String  @id @default(cuid())
  workOrderId String
  text        String
  done        Boolean @default(false)
  sortOrder   Int     @default(0)

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_checklist_items")
}

model WorkOrderReplacementPart {
  id          String   @id @default(cuid())
  workOrderId String
  name        String
  quantity    Int      @default(1)
  cost        Decimal? @db.Decimal(12, 2)

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_replacement_parts")
}

// Parts consumed during a maintenance-side repair (WorkOrder.type = REPAIR/BREAKDOWN).
// Also what Asset.partsChanged/totalRepairCost should be derived from instead of the
// frontend's deduped `partNames: string[]` array.
model WorkOrderRepairPart {
  id               String    @id @default(cuid())
  workOrderId      String
  partName         String
  quantity         Int       @default(1)
  vendorName       String?
  warrantyFromDate DateTime?
  warrantyToDate   DateTime?

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_repair_parts")
}

model WorkOrderApprovalRequest {
  id                String                 @id @default(cuid())
  workOrderId       String
  status            ApprovalDecisionStatus @default(PENDING)
  submissionNote    String?
  submittedByUserId BigInt?
  requestedAt       DateTime               @default(now())
  reviewedAt        DateTime?
  reviewNote        String?
  reviewedByUserId  BigInt?

  workOrder   MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  submittedBy User?                @relation("ApprovalSubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedBy  User?                @relation("ApprovalReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([workOrderId])
  @@map("work_order_approval_requests")
}

model WorkOrderTransfer {
  id          String                 @id @default(cuid())
  workOrderId String
  fromUserId  BigInt?
  toUserId    BigInt
  type        TransferType
  status      ApprovalDecisionStatus @default(PENDING)
  reason      String?
  createdAt   DateTime               @default(now())

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fromUser  User?                @relation("TransferFromUser", fields: [fromUserId], references: [id])
  toUser    User                 @relation("TransferToUser", fields: [toUserId], references: [id])

  @@index([workOrderId])
  @@map("work_order_transfers")
}

model WorkOrderStatusLog {
  id              String           @id @default(cuid())
  workOrderId     String
  fromStatus      WorkOrderStatus?
  toStatus        WorkOrderStatus
  note            String?
  changedByUserId BigInt?
  createdAt       DateTime         @default(now())

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  changedBy User?                @relation("StatusLogChangedBy", fields: [changedByUserId], references: [id])

  @@index([workOrderId])
  @@map("work_order_status_logs")
}

model BreakdownReport {
  id                     String            @id @default(cuid())
  firmId                 BigInt?
  breakdownNumber        String?           @unique
  machineId              String
  failureType            String?
  description            String
  severity               BreakdownSeverity
  status                 BreakdownStatus   @default(OPEN)
  reportedByUserId       BigInt?
  assignedToUserId       BigInt?
  reportedAt             DateTime          @default(now())
  resolvedAt             DateTime?
  rootCause              String?
  correctiveAction       String?
  preventiveAction       String?
  estimatedDowntimeHours Decimal?          @db.Decimal(8, 2)
  actualDowntimeMinutes  Int?
  remarks                String?

  firm       Firm?                 @relation(fields: [firmId], references: [id])
  machine    Machine               @relation(fields: [machineId], references: [id])
  reportedBy User?                 @relation("BreakdownReportedBy", fields: [reportedByUserId], references: [id])
  assignedTo User?                 @relation("BreakdownAssignedTo", fields: [assignedToUserId], references: [id])
  workOrder  MaintenanceWorkOrder?

  @@index([machineId])
  @@index([firmId])
  @@map("breakdown_reports")
}

model DailyMachineLog {
  id               String   @id @default(cuid())
  firmId           BigInt?
  machineId        String
  date             DateTime
  shift            String?
  startTimeReading String?
  endTimeReading   String?
  runtimeHours     Decimal  @default(0) @db.Decimal(8, 2)
  temperature      Decimal? @db.Decimal(6, 2)
  load             Decimal? @db.Decimal(6, 2)
  oilLevel         String?
  vibration        String?
  operatorName     String? // free text — CreateDailyMachineLogDto sends a name, not a user id; no operator picker in this form
  remarks          String?
  createdAt        DateTime @default(now())

  firm    Firm?   @relation(fields: [firmId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
  @@map("daily_machine_logs")
}

// ----- Repair -----

// Deliberately separate from Store's `Vendors` model — repair/AMC vendors (outhouse
// repair shops, spares suppliers, authorized OEMs) are a different pool with
// different fields than procurement/raw-material vendors; see decision #2 in the
// architecture doc.
model RepairVendor {
  id           String   @id @default(cuid())
  firmId       BigInt?
  name         String
  type         String? // e.g. "Outhouse Repair" | "Spares Supplier" | "Authorized OEM" — free text, not enforced as an enum since new vendor types are common
  gstNumber    String?
  email        String?
  address      String?
  mobileNumber String?
  contactName  String?
  createdAt    DateTime @default(now())

  firm          Firm?               @relation(fields: [firmId], references: [id])
  spareParts    SparePart[]
  repairIndents RepairIndent[]
  offers        RepairVendorOffer[]
  amcContracts  AMCContract[]

  @@index([firmId])
  @@map("repair_vendors")
}

model SparePart {
  id          String   @id @default(cuid())
  firmId      BigInt?
  partName    String
  partCode    String?  @unique
  machineType String?
  vendorId    String?
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  stockQty    Int      @default(0)
  minStockQty Int      @default(0)
  unit        String?
  description String?
  createdAt   DateTime @default(now())

  firm         Firm?              @relation(fields: [firmId], references: [id])
  vendor       RepairVendor?      @relation(fields: [vendorId], references: [id])
  indentUsages RepairIndentPart[]

  @@index([firmId])
  @@map("spare_parts")
}

model RepairIndent {
  id                   String                 @id @default(cuid())
  firmId               BigInt?
  indentNumber         String?                @unique
  machineId            String?
  assetId              String?
  machinePartId        String? // which part of the machine is broken — real picker (MachinePart), selected at indent creation
  doerUserId           BigInt? // logged-by user — real `/user/list` picker, same convention as Maintenance's assignee fields
  departmentId         BigInt? // usually auto-filled from machine.departmentId server-side; no department picker in this form
  problem              String
  priority             Priority               @default(MEDIUM)
  status               RepairIndentStatus     @default(PENDING)
  approvalStatus       ApprovalDecisionStatus @default(PENDING)
  routingType          RepairRoutingType?
  expectedDeliveryDays Int?
  location             String?
  image                String?
  remarks              String?
  soundOfMachine       String?
  temperature          String?
  maintenanceCost      Decimal?               @db.Decimal(12, 2)
  approvedAt           DateTime?
  vendorId             String?
  technicianId         String?
  technicianAssignedAt DateTime?
  technicianWorkNotes  String?
  workOrderId          String?                @map("work_order_id")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  firm           Firm?              @relation(fields: [firmId], references: [id])
  machine        Machine?           @relation(fields: [machineId], references: [id])
  asset          Asset?             @relation(fields: [assetId], references: [id])
  machinePart    MachinePart?       @relation(fields: [machinePartId], references: [id])
  department     Department?        @relation(fields: [departmentId], references: [id])
  doer           User?              @relation("IndentDoer", fields: [doerUserId], references: [id])
  vendor         RepairVendor?      @relation(fields: [vendorId], references: [id])
  technician     Technician?        @relation(fields: [technicianId], references: [id])
  parts          RepairIndentPart[]
  outhouseRepair OuthouseRepair?
  workOrder      MaintenanceWorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([machineId])
  @@index([workOrderId])
  @@index([assetId])
  @@index([firmId])
  @@index([status])
  @@map("repair_indents")
}

// Parts-used line items — fills the gap where the frontend only had a single
// `machinePartName` string per indent plus an aggregated `Asset.partNames[]` array.
model RepairIndentPart {
  id       String   @id @default(cuid())
  indentId String
  partId   String?
  partName String
  quantity Int      @default(1)
  cost     Decimal? @db.Decimal(12, 2)

  indent RepairIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  part   SparePart?   @relation(fields: [partId], references: [id])

  @@index([indentId])
  @@map("repair_indent_parts")
}

// 1:1 with RepairIndent when routingType = OUTHOUSE. The frontend flattened dispatch
// -> receiving/inspection -> billing -> payment into one `RBOuthouseRepair` record;
// split here into per-stage child tables (RepairDispatch/RepairReceiving/RepairPayment)
// since each stage is filled in by a different screen at a different point in time.
model OuthouseRepair {
  id               String    @id @default(cuid())
  indentId         String    @unique
  vendorRemarks    String?
  vendorAssignedAt DateTime?
  rateApprovedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  indent    RepairIndent        @relation(fields: [indentId], references: [id], onDelete: Cascade)
  offers    RepairVendorOffer[]
  dispatch  RepairDispatch?
  receiving RepairReceiving?
  payment   RepairPayment?

  @@map("outhouse_repairs")
}

// Competing vendor rate quotes for an outhouse repair — one gets isApproved = true.
model RepairVendorOffer {
  id               String   @id @default(cuid())
  outhouseRepairId String
  vendorId         String
  rate             Decimal  @db.Decimal(12, 2)
  paymentTerm      String?
  isApproved       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  outhouseRepair OuthouseRepair @relation(fields: [outhouseRepairId], references: [id], onDelete: Cascade)
  vendor         RepairVendor   @relation(fields: [vendorId], references: [id])

  @@index([outhouseRepairId])
  @@map("repair_vendor_offers")
}

// Sent-machine stage: machine dispatched to the outhouse vendor.
model RepairDispatch {
  id                    String    @id @default(cuid())
  outhouseRepairId      String    @unique
  transporterName       String?
  vehicleNo             String?
  driverName            String?
  driverContact         String?
  transportationCharges Decimal?  @db.Decimal(12, 2)
  weighmentSlipNo       String?
  transportImage        String?
  sentPaymentType       String?
  sentPaymentAmount     Decimal?  @db.Decimal(12, 2)
  sentAt                DateTime?
  expectedReturnDate    DateTime?

  outhouseRepair OuthouseRepair @relation(fields: [outhouseRepairId], references: [id], onDelete: Cascade)

  @@map("repair_dispatches")
}

// Store-in stage: machine received back, inspected, bill logged.
model RepairReceiving {
  id                    String            @id @default(cuid())
  outhouseRepairId      String            @unique
  inspectedByUserId     BigInt?
  inspectedByName       String?
  inspectionResult      InspectionResult?
  inspectionRemarks     String?
  returnTransporterName String?
  returnTransportAmount Decimal?          @db.Decimal(12, 2)
  billImage             String?
  billNo                String?
  typeOfBill            String?
  totalBillAmount       Decimal?          @db.Decimal(12, 2)
  toBePaidAmount        Decimal?          @db.Decimal(12, 2)
  receivedAt            DateTime?
  status                StoreInStatus     @default(PENDING_VERIFICATION)

  outhouseRepair OuthouseRepair @relation(fields: [outhouseRepairId], references: [id], onDelete: Cascade)
  inspectedBy    User?          @relation("ReceivingInspectedBy", fields: [inspectedByUserId], references: [id])

  @@map("repair_receivings")
}

// Payment stage: final billing/payment reconciliation.
model RepairPayment {
  id                 String              @id @default(cuid())
  outhouseRepairId   String              @unique
  billMatch          Boolean?
  billStatus         String?
  finalPaymentAmount Decimal?            @db.Decimal(12, 2)
  paymentMode        RepairPaymentMode?
  status             RepairPaymentStatus @default(PENDING_APPROVAL)
  paidAt             DateTime?

  outhouseRepair OuthouseRepair @relation(fields: [outhouseRepairId], references: [id], onDelete: Cascade)

  @@map("repair_payments")
}

model Technician {
  id           String   @id @default(cuid())
  firmId       BigInt?
  name         String
  contact      String?
  whatsapp     String?
  departmentId BigInt?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  firm       Firm?          @relation(fields: [firmId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  indents    RepairIndent[]

  @@index([firmId])
  @@map("technicians")
}

model AMCContract {
  id              String    @id @default(cuid())
  firmId          BigInt?
  contractNumber  String?   @unique
  machineId       String?
  assetId         String?
  vendorId        String?
  startDate       DateTime
  endDate         DateTime
  annualCost      Decimal   @db.Decimal(12, 2)
  visitsPerYear   Int       @default(0)
  completedVisits Int       @default(0)
  status          AMCStatus @default(ACTIVE)
  scope           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  firm    Firm?         @relation(fields: [firmId], references: [id])
  machine Machine?      @relation(fields: [machineId], references: [id])
  asset   Asset?        @relation(fields: [assetId], references: [id])
  vendor  RepairVendor? @relation(fields: [vendorId], references: [id])

  @@index([firmId])
  @@map("amc_contracts")
}

// Atomic counter backing every "{PREFIX}-{YEAR}-{seq}" business code (REP-2026-001,
// WO-2026-001, BD-2026-001, AMC-2026-001, ...). Replaces the frontend mocks'
// collision-prone `array.length + 1` numbering (breaks after any delete) — increment
// lastValue inside a transaction per code generation.
model DocumentSequence {
  id        String  @id @default(cuid())
  firmId    BigInt?
  prefix    String
  year      Int
  lastValue Int     @default(0)

  firm Firm? @relation(fields: [firmId], references: [id])

  @@unique([firmId, prefix, year])
  @@map("document_sequences")
}
