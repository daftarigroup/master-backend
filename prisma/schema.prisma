// Prisma Schema for Store App (Refactored from master-frontend/database/store_schema.sql)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccessType {
  VIEW
  EDIT
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum TaskStatus {
  pending
  done
  extend
  extended
  approved
  rejected
}

model AreaOfUse {
  id         BigInt   @id @default(autoincrement())
  name       String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz()
  firm_id    BigInt?
  firm_name  String?  @db.Text
  firm       Firm?    @relation(fields: [firm_id], references: [id])

  @@map("area_of_use")
}

model Company {
  id                  BigInt   @id @default(autoincrement())
  company_name        String   @db.Text
  gstin               String?  @db.Text
  pan                 String?  @db.Text
  email               String?  @db.Text
  phone               String?  @db.Text
  address             String?  @db.Text
  contact_person      String?  @db.Text
  created_at          DateTime @default(now()) @db.Timestamptz()
  updated_at          DateTime @default(now()) @db.Timestamptz()
  billing_address     String?  @db.Text
  destination_address String?  @db.Text
  firm_id             BigInt?
  firm_name           String?  @db.Text
  firm_rel            Firm?    @relation("company_firm", fields: [firm_id], references: [id])
  firm                Firm[]

  @@map("company")
}

model ContractorDetails {
  id                 BigInt    @id @default(autoincrement())
  created_at         DateTime? @default(now()) @db.Timestamptz()
  contractor_name    String    @db.Text
  contractor_gstin   String?   @db.Text
  contractor_address String?   @db.Text
  contractor_email   String?   @db.Text
  responsible_person String?   @db.Text
  location           String?   @db.Text
  phone              String?   @db.Text
  firm_id            BigInt?
  firm_name          String?   @db.Text
  firm               Firm?     @relation(fields: [firm_id], references: [id])

  @@map("contractor_details")
}

model DefaultPoTerms {
  id         BigInt   @id @default(autoincrement())
  term_text  String   @db.Text
  sort_order Int?
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz()
  firm_id    BigInt?
  firm_name  String?  @db.Text
  firm       Firm?    @relation(fields: [firm_id], references: [id])

  @@map("default_po_terms")
}

model Department {
  id         BigInt     @id @default(autoincrement())
  name       String     @db.Text
  created_at DateTime   @default(now()) @db.Timestamptz()
  employees  Employee[]

  // Asset / Maintenance / Repair system
  machines       Machine[]
  repair_indents RepairIndent[]
  technicians    Technician[]

  @@map("department")
}

model Firm {
  // fleet_v2_cost back-relations
  fleetSettings      FleetSettings?
  wbsActivities      WbsActivity[]
  machineRates       MachineRate[]
  machineCostEntries MachineCostEntry[]
  workTypes          WorkType[]               // fleet_v3_ops
  checklistTemplates ChecklistTemplate[]
  serviceSchedules   MachineServiceSchedule[]
  machineDocuments   MachineDocument[]
  documentTypes      DocumentType[]
  machineAssignments MachineAssignment[]
  transfersFrom      MachineTransfer[]        @relation("TransferFromFirm")
  transfersTo        MachineTransfer[]        @relation("TransferToFirm")

  id                           BigInt                @id @default(autoincrement())
  company_id                   BigInt?
  firm_name                    String                @db.Text
  billing_address              String?               @db.Text
  destination_address          String?               @db.Text
  contact_person               String?               @db.Text
  active                       Boolean               @default(true)
  created_at                   DateTime              @default(now()) @db.Timestamptz()
  updated_at                   DateTime              @default(now()) @db.Timestamptz()
  company                      Company?              @relation(fields: [company_id], references: [id])
  fullkitting                  Fullkitting[]
  indent                       Indent[]
  inventory                    Inventory[]
  issue                        Issue[]
  payment_history              PaymentHistory[]
  payments                     Payments[]
  po_master                    PoMaster[]
  quotation_history            QuotationHistory[]
  stock_transfers_from_firm_id StockTransfers[]      @relation("from_firm_id")
  stock_transfers_to_firm_id   StockTransfers[]      @relation("to_firm_id")
  store_in                     StoreIn[]
  store_in_direct              StoreInDirect[]
  tally_entry                  TallyEntry[]
  item                         Item[]
  checklist_task               ChecklistTask[]
  delegation_task              DelegationTask[]
  area_of_use                  AreaOfUse[]
  company_records              Company[]             @relation("company_firm")
  contractor_details           ContractorDetails[]
  default_po_terms             DefaultPoTerms[]
  group_head                   GroupHead[]
  site_engineer_details        SiteEngineerDetails[]
  site_location_details        SiteLocationDetails[]
  terms_and_condition          TermsAndCondition[]
  uom                          Uom[]
  vendors                      Vendors[]
  project_assignments          ProjectAssignment[]
  employees                    Employee[]            @relation("EmployeeHomeFirm")

  // Asset / Maintenance / Repair system
  assets                  Asset[]
  machines                Machine[]
  activity_types          ActivityType[]
  maintenance_plans       MaintenancePlan[]
  maintenance_work_orders MaintenanceWorkOrder[]
  breakdown_reports       BreakdownReport[]
  daily_machine_logs      DailyMachineLog[]
  repair_vendors          RepairVendor[]
  spare_parts             SparePart[]
  repair_indents          RepairIndent[]
  technicians             Technician[]
  amc_contracts           AMCContract[]

  dieselReceipts   DieselReceipt[]
  dieselLogs       DieselLog[]
  machineUsageLogs MachineUsageLog[]

  @@map("firm")
}

model Fullkitting {
  id                    BigInt    @id @default(autoincrement())
  timestamp             DateTime  @db.Timestamp()
  indent_number         String?   @db.Text
  vendor_name           String?   @db.Text
  product_name          String?   @db.Text
  qty                   String?   @db.Text
  bill_no               String?   @db.Text
  transporting_include  String?   @db.Text
  transporter_name      String?   @db.Text
  amount                String?   @db.Text
  vehical_no            String?   @db.Text
  driver_name           String?   @db.Text
  driver_mobile_no      String?   @db.Text
  planned               DateTime? @db.Timestamp()
  actual                DateTime? @db.Timestamp()
  time_delay            String?   @db.Text
  fms_name_match        String?   @db.Text
  status                String?   @db.Text
  vehicle_number        String?   @db.Text
  from                  String?   @db.Text
  to                    String?   @db.Text
  material_load_details String?   @db.Text
  bilty_number          String?   @db.Text
  rate_type             String?   @db.Text
  amount1               String?   @db.Text
  bilty_image           String?   @db.Text
  firm_name             String?   @db.Text
  firm_id               BigInt?
  firm                  Firm?     @relation(fields: [firm_id], references: [id])

  @@map("fullkitting")
}

model GroupHead {
  id         BigInt   @id @default(autoincrement())
  name       String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz()
  firm_id    BigInt?
  firm_name  String?  @db.Text
  firm       Firm?    @relation(fields: [firm_id], references: [id])
  item       Item[]

  @@map("group_head")
}

model Indent {
  id                       BigInt    @id @default(autoincrement())
  timestamp                DateTime  @db.Timestamptz()
  indent_number            String?   @db.Text
  firm_name                String?   @db.Text
  indenter_name            String?   @db.Text
  department               String?   @db.Text
  area_of_use              String?   @db.Text
  group_head               String?   @db.Text
  product_name             String?   @db.Text
  quantity                 String?   @db.Text
  uom                      String?   @db.Text
  specifications           String?   @db.Text
  indent_approved_by       String?   @db.Text
  indent_type              String?   @db.Text
  attachment               String?   @db.Text
  indent_status            String?   @db.Text
  no_day                   String?   @db.Text
  planned1                 DateTime? @db.Timestamp()
  actual1                  DateTime? @db.Timestamp()
  time_delay1              String?   @db.Text
  vendor_type              String?   @db.Text
  approved_quantity        String?   @db.Text
  planned2                 DateTime? @db.Timestamp()
  actual2                  DateTime? @db.Timestamp()
  time_delay2              String?   @db.Text
  vendor_name1             String?   @db.Text
  select_rate_type1        String?   @db.Text
  rate1                    String?   @db.Text
  with_tax_or_not1         String?   @db.Text
  tax_value1               String?   @db.Text
  payment_term1            String?   @db.Text
  whatsapp_number1         String?   @db.Text
  email_id1                String?   @db.Text
  vendor_name2             String?   @db.Text
  select_rate_type2        String?   @db.Text
  rate2                    String?   @db.Text
  with_tax_or_not2         String?   @db.Text
  tax_value2               String?   @db.Text
  payment_term2            String?   @db.Text
  whatsapp_number2         String?   @db.Text
  email_id2                String?   @db.Text
  vendor_name3             String?   @db.Text
  select_rate_type3        String?   @db.Text
  rate3                    String?   @db.Text
  with_tax_or_not3         String?   @db.Text
  tax_value3               String?   @db.Text
  payment_term3            String?   @db.Text
  whatsapp_number3         String?   @db.Text
  email_id3                String?   @db.Text
  product_code             String?   @db.Text
  comparison_sheet         String?   @db.Text
  planned3                 DateTime? @db.Timestamp()
  actual3                  DateTime? @db.Timestamp()
  time_delay3              String?   @db.Text
  approved_vendor_name     String?   @db.Text
  approved_rate            String?   @db.Text
  with_tax_or_not4         String?   @db.Text
  tax_value4               String?   @db.Text
  approved_payment_term    String?   @db.Text
  approved_date            String?   @db.Text
  planned4                 DateTime? @db.Timestamp()
  actual4                  DateTime? @db.Timestamp()
  time_delay4              String?   @db.Text
  po_number                String?   @db.Text
  po_copy                  String?   @db.Text
  payment_term             String?   @db.Text
  planned5                 DateTime? @db.Timestamp()
  actual5                  DateTime? @db.Timestamp()
  time_delay               String?   @db.Text
  po_qty                   String?   @db.Text
  pending_po_qty           String?   @db.Text
  status                   String?   @db.Text
  total_qty                String?   @db.Text
  received_qty             String?   @db.Text
  planned7                 DateTime? @db.Timestamp()
  actual7                  DateTime? @db.Timestamp()
  time_delay7              String?   @db.Text
  make_payment_link        String?   @db.Text
  lifting_status           String?   @db.Text
  pending_lift_qty         String?   @db.Text
  po_requred               String?   @db.Text
  vendor_rate              String?   @db.Text
  vendor_amount            String?   @db.Text
  delivery_date            DateTime? @db.Date
  payment_type             String?   @db.Text
  pending_qty              String?   @db.Text
  cancel_qty               String?   @db.Text
  advance_percent1         String?   @db.Text
  advance_percent2         String?   @db.Text
  advance_percent3         String?   @db.Text
  approved_advance_percent String?   @db.Text
  expected_req_date        DateTime? @db.Date
  min_stock_qty            String?   @db.Text
  quotation_no1            String?   @default("") @db.Text
  quotation_date1          String?   @default("") @db.Text
  quotation_no2            String?   @default("") @db.Text
  quotation_date2          String?   @default("") @db.Text
  quotation_no3            String?   @default("") @db.Text
  quotation_date3          String?   @default("") @db.Text
  approved_quotation_no    String?   @default("") @db.Text
  approved_quotation_date  String?   @default("") @db.Text
  vendor1_rank             String?   @db.Text
  vendor2_rank             String?   @db.Text
  vendor3_rank             String?   @db.Text
  delivery_time1           String?   @db.Text
  delivery_time2           String?   @db.Text
  delivery_time3           String?   @db.Text
  make1                    String?   @db.Text
  make2                    String?   @db.Text
  make3                    String?   @db.Text
  indent_url               String?   @default("") @db.Text
  accept_indent_url        String?   @default("") @db.Text
  firm_id                  BigInt?
  firm                     Firm?     @relation(fields: [firm_id], references: [id])

  item_id BigInt? // store_item_ref_v1: link to the item master; product_name stays as display text
  item    Item?   @relation(fields: [item_id], references: [id])

  // fleet_v7_repair_parts: raised from a repair work order's part list
  work_order_id String?
  wo_part_id    String?
  work_order    MaintenanceWorkOrder?     @relation("IndentWorkOrder", fields: [work_order_id], references: [id], onDelete: SetNull)
  wo_part       WorkOrderPartRequirement? @relation("IndentPartRequirement", fields: [wo_part_id], references: [id], onDelete: SetNull)

  @@index([firm_id, item_id], map: "indent_firm_item_idx")
  @@index([work_order_id], map: "indent_work_order_idx")
  @@map("indent")
}

model Inventory {
  id                BigInt   @id @default(autoincrement())
  timestamp         DateTime @default(now()) @db.Timestamp()
  group_head        String?  @db.Text
  item_name         String?  @db.Text
  uom               String?  @db.Text
  max_level         String?  @db.Text
  opening           String?  @db.Text
  individual_rate   String?  @db.Text
  avg_price         Decimal?
  indented          Decimal? @default(0)
  approved          Decimal?
  purchase_quantity Decimal?
  out_quantity      Decimal?
  current           Decimal?
  total_price       Decimal?
  color_code        String?  @db.Text
  received_quantity Decimal?
  return_quantity   Decimal?
  request_quantity  Decimal?
  firm_name         String?  @db.Text
  firm_id           BigInt?
  firm              Firm?    @relation(fields: [firm_id], references: [id])

  item_id BigInt? // store_item_ref_v1
  item    Item?   @relation(fields: [item_id], references: [id])

  @@index([firm_id, item_id], map: "inventory_firm_item_idx")
  @@map("inventory")
}

model Issue {
  id                  BigInt    @id @default(autoincrement())
  timestamp           DateTime  @db.Timestamptz()
  department          String?   @db.Text
  group_head          String?   @db.Text
  product_name        String?   @db.Text
  quantity            String?   @db.Text
  uom                 String?   @db.Text
  issue_to            String?   @db.Text
  planned1            DateTime? @db.Timestamp()
  actual1             DateTime? @db.Timestamp()
  time_delay1         String?   @db.Text
  status              String?   @db.Text
  given_qty           String?   @db.Text
  issue_no            String?   @db.Text
  constructor_name    String?   @db.Text
  site_location       String?   @db.Text
  firm_name           String?   @db.Text
  rejected_damage_qty String?   @db.Text
  damage_remark       String?   @db.Text
  return_person_name  String?   @db.Text
  issue_person_name   String?   @db.Text
  issue_slip          String?   @db.Text
  return_slip         String?   @db.Text
  firm_id             BigInt?
  firm                Firm?     @relation(fields: [firm_id], references: [id])

  item_id BigInt? // store_item_ref_v1
  item    Item?   @relation(fields: [item_id], references: [id])

  // store_issue_kind_v1: MATERIAL (contractor / site, as always) | MAINTENANCE (parts to a machine) | ASSET_DIESEL (diesel to a machine)
  issue_kind    String     @default("MATERIAL")
  machine_id    String?
  work_order_id String?
  meter_reading Decimal?   @db.Decimal(14, 2)
  machine       Machine?   @relation("StoreIssueMachine", fields: [machine_id], references: [id], onDelete: Restrict)
  work_order    MaintenanceWorkOrder? @relation("StoreIssueWorkOrder", fields: [work_order_id], references: [id], onDelete: SetNull)
  dieselLogs    DieselLog[]           @relation("StoreIssueDieselLog") // fleet_v6_store_diesel

  // fleet_v7_repair_parts: the work order part line this issue is against
  requirement_id String?
  requirement    WorkOrderPartRequirement? @relation("IssuePartRequirement", fields: [requirement_id], references: [id], onDelete: SetNull)
  partIssues     WorkOrderPartIssue[]      @relation("StoreIssuePartIssue")

  @@index([firm_id, item_id], map: "issue_firm_item_idx")
  @@index([requirement_id], map: "issue_requirement_idx")
  @@index([issue_kind], map: "issue_kind_idx")
  @@index([machine_id], map: "issue_machine_idx")
  @@map("issue")
}

model Item {
  id                        BigInt     @id @default(autoincrement())
  item_name                 String     @db.Text
  group_head_id             BigInt?
  uom_id                    BigInt?
  firm_id                   BigInt?
  created_at                DateTime   @default(now()) @db.Timestamptz()
  regular_pay_condition     String?    @db.Text
  third_party_pay_condition String?    @db.Text
  group_head                GroupHead? @relation(fields: [group_head_id], references: [id])
  uom                       Uom?       @relation(fields: [uom_id], references: [id])
  firm                      Firm?      @relation(fields: [firm_id], references: [id])

  // store_item_ref_v1 back-relations
  indents         Indent[]
  inventoryRows   Inventory[]
  issues          Issue[]
  partRequirements WorkOrderPartRequirement[] @relation("PartRequirementItem")
  poLines         PoMaster[]
  stockTransfers  StockTransfers[]
  storeInRows     StoreIn[]
  storeInDirects  StoreInDirect[]

  @@map("item")
}

model Master {
  created_at             DateTime @default(now()) @db.Timestamptz()
  vendor_name            String?  @db.Text
  vendor_gstin           String?  @db.Text
  vendor_address         String?  @db.Text
  vendor_email           String?  @db.Text
  payment_term           String?  @db.Text
  department             String?  @db.Text
  group_head             String?  @db.Text
  item_name              String?  @db.Text
  company_name           String?  @db.Text
  company_address        String?  @db.Text
  company_email          String?  @db.Text
  company_gstin          String?  @db.Text
  company_phone          String?  @db.Text
  billing_address        String?  @db.Text
  company_pan            String?  @db.Text
  destination_address    String?  @db.Text
  default_terms          String?  @db.Text
  person_name            String?  @db.Text
  firm_name              String?  @db.Text
  uom                    String?  @db.Text
  where                  String?  @db.Text
  fms_name               String?  @db.Text
  indenter_name          String?  @db.Text
  id                     BigInt   @id @default(autoincrement())
  responsible_person     String?  @db.Text
  regular                String?  @db.Text
  location               String?  @db.Text
  phone                  String?  @db.Text
  regular_conditions     String?  @db.Text
  third_party_conditions String?  @db.Text
  area_of_use            String?  @db.Text
  company_contact_person String?  @db.Text

  @@map("master")
}

model PaymentHistory {
  id                         BigInt    @id @default(autoincrement())
  timestamp                  DateTime  @db.Timestamptz()
  ap_payment_number          String?   @db.Text
  status                     String?   @db.Text
  unique_number              String?   @db.Text
  fms_name                   String?   @db.Text
  pay_to                     String?   @db.Text
  amount_to_be_paid          String?   @db.Text
  remarks                    String?   @db.Text
  any_attachments            String?   @db.Text
  timestamp1                 DateTime? @db.Timestamp()
  lift_number                String?   @db.Text
  indent_no                  String?   @db.Text
  po_number                  String?   @db.Text
  vendor_name                String?   @db.Text
  product_name               String?   @db.Text
  bill_status                String?   @db.Text
  bill_no                    String?   @db.Text
  qty                        String?   @db.Text
  lead_time_to_lift_material String?   @db.Text
  type_of_bill               String?   @db.Text
  bill_amount                String?   @db.Text
  discount_amount            String?   @db.Text
  payment_type               String?   @db.Text
  advance_amount_if_any      String?   @db.Text
  photo_of_bill              String?   @db.Text
  transportation_include     String?   @db.Text
  transporter_name           String?   @db.Text
  amount                     String?   @db.Text
  vehicle_no                 String?   @db.Text
  driver_name                String?   @db.Text
  driver_mobile_no           String?   @db.Text
  bill_remark                String?   @db.Text
  planned                    DateTime? @db.Date
  payment_terms              String?   @db.Text
  firm_id                    BigInt?
  firm                       Firm?     @relation(fields: [firm_id], references: [id])

  @@map("payment_history")
}

model Payments {
  id                 BigInt    @id @default(autoincrement())
  timestamp          DateTime? @db.Timestamptz()
  unique_no          String?   @db.Text
  party_name         String?   @db.Text
  po_number          String?   @db.Text
  total_po_amount    String?   @db.Text
  internal_code      String?   @db.Text
  product            String?   @db.Text
  delivery_date      DateTime? @db.Date
  payment_terms      String?   @db.Text
  number_of_days     String?   @db.Text
  pdf                String?   @db.Text
  pay_amount         String?   @db.Text
  file               String?   @db.Text
  remark             String?   @db.Text
  total_paid_amount  String?   @db.Text
  outstanding_amount String?   @db.Text
  status             String?   @db.Text
  planned            DateTime? @db.Date
  actual             DateTime? @db.Date
  type_of_bill       String?   @db.Text
  status1            String?   @db.Text
  payment_form       String?   @db.Text
  firm_name          String?   @db.Text
  payment_done       Boolean?
  firm_id            BigInt?
  firm               Firm?     @relation(fields: [firm_id], references: [id])

  @@map("payments")
}

model PcReport {
  id                 BigInt    @id @default(autoincrement())
  created_at         DateTime  @default(now()) @db.Timestamptz()
  stage              String?   @db.Text
  total_pending      String?   @db.Text
  total_complete     String?   @db.Text
  pending_pmpl       String?   @db.Text
  pending_purab      String?   @db.Text
  pending_pmmpl      String?   @db.Text
  pending_refrasynth String?   @db.Text
  updated_at         DateTime? @default(now()) @db.Timestamptz()

  @@map("pc_report")
}

model PoMaster {
  id                      BigInt   @id @default(autoincrement())
  timestamp               DateTime @db.Timestamptz()
  po_created_date         String?  @db.Text
  party_name              String?  @db.Text
  po_number               String?  @db.Text
  quotation_number        String?  @db.Text
  quotation_date          String?  @db.Text
  enquiry_number          String?  @db.Text
  enquiry_date            String?  @db.Text
  internal_code           String?  @db.Text
  product                 String?  @db.Text
  description             String?  @db.Text
  quantity                String?  @db.Text
  unit                    String?  @db.Text
  rate                    String?  @db.Text
  gst                     String?  @db.Text
  discount                String?  @db.Text
  amount                  String?  @db.Text
  total_po_amount         String?  @db.Text
  prepared_by             String?  @db.Text
  approved_by             String?  @db.Text
  pdf                     String?  @db.Text
  delivery_date           String?  @db.Text
  payment_terms           String?  @db.Text
  number_of_days          String?  @db.Text
  term1                   String?  @db.Text
  term2                   String?  @db.Text
  term3                   String?  @db.Text
  term4                   String?  @db.Text
  term5                   String?  @db.Text
  term6                   String?  @db.Text
  term7                   String?  @db.Text
  term8                   String?  @db.Text
  term9                   String?  @db.Text
  term10                  String?  @db.Text
  email_send_status       String?  @db.Text
  delivery_days           String?  @db.Text
  delivery_type           String?  @db.Text
  firm_name               String?  @db.Text
  total_paid_amount       Decimal?
  outstanding_amount      Decimal?
  status                  String?  @db.Text
  company_email           String?  @db.Text
  advance_percent         Decimal? @default(0)
  advance_amount          Decimal? @default(0)
  terms                   String?  @db.Text
