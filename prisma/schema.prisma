enum ProjectAssignmentStatus {
  active
  on_leave
  shifted
  removed
  completed
}

enum ProjectAssignmentEventType {
  assigned
  resumed
  shifted
  removed
  completed
  put_on_leave
}

model ProjectAssignment {
  id                   BigInt                  @id @default(autoincrement())
  employee_id          String                  @db.Text
  firm_id              BigInt
  firm_name            String                  @db.Text
  role_on_project      String                  @db.Text
  status               ProjectAssignmentStatus @default(active)
  assigned_date        DateTime                @db.Timestamptz()
  end_date             DateTime?               @db.Timestamptz()
  linked_assignment_id BigInt?
  reason               String?                 @db.Text
  approved_by          String?                 @db.Text
  created_at           DateTime                @default(now()) @db.Timestamptz()
  updated_at           DateTime                @default(now()) @updatedAt @db.Timestamptz()

  firm                 Firm                    @relation(fields: [firm_id], references: [id])
  employee             Employee?               @relation(fields: [employee_id], references: [employee_id])
  linked_assignment    ProjectAssignment?      @relation("AssignmentChain", fields: [linked_assignment_id], references: [id])
  chained_assignments  ProjectAssignment[]     @relation("AssignmentChain")
  events               ProjectAssignmentEvent[]

  @@index([employee_id])
  @@index([firm_id])
  @@index([status])
  @@map("project_assignments")
}

model ProjectAssignmentEvent {
  id             BigInt                     @id @default(autoincrement())
  assignment_id  BigInt
  employee_id    String                     @db.Text
  event_type     ProjectAssignmentEventType
  from_firm_id   BigInt?
  to_firm_id     BigInt?
  from_firm_name String?                    @db.Text
  to_firm_name   String?                    @db.Text
  notes          String?                    @db.Text
  performed_by   String?                    @db.Text
  created_at     DateTime                   @default(now()) @db.Timestamptz()

  assignment     ProjectAssignment          @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@index([assignment_id])
  @@index([employee_id])
  @@map("project_assignment_events")
}

model Employee {
  id                         BigInt              @id @default(autoincrement())
  employee_id                String              @unique @default(cuid())
  emp_code                   String?             @unique
  name                       String              @db.Text
  phone                      String?             @db.Text
  email                      String?             @db.Text
  designation                String?             @db.Text
  status                     String              @default("active")

  // Scoping & Relationships
  department_id              BigInt?
  home_firm_id               BigInt?
  user_id                    BigInt?             @unique

  // Work & Dates (all timestamptz)
  joining_date               DateTime?           @db.Timestamptz()
  last_working_day           DateTime?           @db.Timestamptz()
  termination_date           DateTime?           @db.Timestamptz()
  separation_type            String?             @db.Text
  leaving_reason             String?             @db.Text
  manager_name               String?             @db.Text
  work_location              String?             @db.Text
  employment_type            String?             @db.Text
  joining_place              String?             @db.Text
  attendance_mode            String?             @db.Text
  probation_months           Int?

  // Financial & Compensation
  offered_ctc                String?             @db.Text
  monthly_salary             Decimal?            @db.Decimal(12, 2)
  bank_account               String?             @db.Text
  ifsc_code                  String?             @db.Text
  bank_branch_name           String?             @db.Text
  payment_mode               String?             @db.Text
  pf_eligible                Boolean?            @default(false)
  esic_eligible              Boolean?            @default(false)
  past_pf_no                 String?             @db.Text
  esic_no                    String?             @db.Text

  // Personal Details & Identification
  blood_group                String?             @db.Text
  father_name                String?             @db.Text
  highest_qualification      String?             @db.Text
  current_address            String?             @db.Text
  aadhar_address             String?             @db.Text
  aadhar_no                  String?             @db.Text

  // Emergency Contact
  emergency_contact_name     String?             @db.Text
  emergency_contact_phone    String?             @db.Text
  emergency_contact_relation String?             @db.Text

  // Asset Issuance Flags
  email_to_be_issued         Boolean?            @default(false)
  mobile_to_be_issued        Boolean?            @default(false)
  laptop_to_be_issued        Boolean?            @default(false)

  // Candidate link & Onboarding / Separation Flags
  candidate_id               BigInt?             @unique
  salary_on_hold             Boolean?            @default(false)
  salary_hold_reason         String?             @db.Text
  offer_letter_issued        Boolean?            @default(false)
  id_card_issued             Boolean?            @default(false)
  induction_done             Boolean?            @default(false)
  onboarding_checklist       Json?
  exit_checklist             Json?
  custom_checklist_items     Json?

  // Timestamps
  created_at                 DateTime            @default(now()) @db.Timestamptz()
  updated_at                 DateTime            @default(now()) @updatedAt @db.Timestamptz()

  // Relations
  user                       User?               @relation(fields: [user_id], references: [id])
  department                 Department?         @relation(fields: [department_id], references: [id])
  home_firm                  Firm?               @relation("EmployeeHomeFirm", fields: [home_firm_id], references: [id])
  project_assignments        ProjectAssignment[]
  candidate                  HrCandidate?        @relation(fields: [candidate_id], references: [id])
  joining                    HrJoining?
  attendances                HrAttendance[]
  attendance_claims          HrAttendanceClaim[]
  attendance_punches         HrAttendancePunch[]
  leaves                     HrLeave[]
  gate_passes                HrGatePass[]
  advance_requests           HrAdvanceRequest[]
  loans                      HrEmployeeLoan[]
  salary_structure           HrSalaryStructure?
  payslips                   HrPayslip[]

  @@index([status])
  @@index([home_firm_id])
  @@index([department_id])
  @@index([phone])
  @@map("employee")
}

