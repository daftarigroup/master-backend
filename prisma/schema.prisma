  firmId           BigInt?
  machineId        String
  date             DateTime
  shift            String?
  startTimeReading String?
  endTimeReading   String?
  runtimeHours     Decimal  @default(0) @db.Decimal(8, 2)
  temperature      Decimal? @db.Decimal(6, 2)
  load             Decimal? @db.Decimal(6, 2)
