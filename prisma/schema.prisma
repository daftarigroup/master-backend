  photo_of_product    String?  @db.Text
  warranty_status     String?  @db.Text
  end_date            String?  @db.Text
  bill_status         String?  @db.Text
  bill_number         String?  @db.Text
  bill_amount         String?  @db.Text
  photo_of_bill       String?  @db.Text
  any_transportations String?  @db.Text
  transporter_name    String?  @db.Text
