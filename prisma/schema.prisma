// ===================== PETTY CASH & EXPENSE SYSTEM =====================

enum PettyCashEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PettyCashLedgerType {
  CREDIT
  EXPENSE
  DEBIT
}

model Credit {
  id            String               @id @default(cuid())
  sn            String               @unique
  personName    String
  projectName   String?
  date          DateTime             @db.Date
  amount        Decimal              @db.Decimal(12, 2)
  paymentMode   String
  image         String?
  remarks       String?
  status        PettyCashEntryStatus @default(APPROVED)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  ledgerEntries LedgerEntry[]

  @@index([personName])
  @@map("credits")
}

model Expense {
  id            String               @id @default(cuid())
  sn            String               @unique
  personName    String
  projectName   String?
  date          DateTime             @db.Date
  amount        Decimal              @db.Decimal(12, 2)
  paymentMode   String
  groupHead     String
  image         String?
  remarks       String?
  status        PettyCashEntryStatus @default(PENDING)
  approvedBy    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  ledgerEntries LedgerEntry[]

  @@index([personName])
  @@map("expenses")
}

model LedgerEntry {
  id         String              @id @default(cuid())
  personName String
  type       PettyCashLedgerType
  amount     Decimal             @db.Decimal(12, 2)
  date       DateTime            @db.Date
  balance    Decimal             @db.Decimal(12, 2)
  createdAt  DateTime            @default(now())

  creditId  String?
  credit    Credit?  @relation(fields: [creditId], references: [id])
  expenseId String?
  expense   Expense? @relation(fields: [expenseId], references: [id])

  @@index([personName])
  @@map("ledger_entries")
}

model ProjectMaster {
  id        String   @id @default(cuid())
  type      String
  value     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([type])
  @@map("project_master")
}

model PettyCashSettings {
  id               Int      @id @default(1)
  paymentModes     String[] @default([])
  lastSerialNumber Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@map("settings")
}

